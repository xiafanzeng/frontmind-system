{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/e10-body-selection-v2.3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "stage", "selected_body", "reason", "issues"],
  "properties": {
    "schema_version": {"const": "2.3.0"},
    "job_id": {"type": "string", "pattern": "^job_"},
    "stage": {"const": "E10"},
    "selected_body": {"enum": ["editorial_master", "optimized_candidate"]},
    "reason": {"type": "string", "minLength": 1},
    "issues": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
