{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/e10-structured-data-template-v2.3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "title_placeholder", "meta_description_placeholder", "templates"],
  "properties": {
    "schema_version": {"const": "2.3.0"},
    "job_id": {"type": "string", "pattern": "^job_"},
    "title_placeholder": {"const": "{{TITLE}}"},
    "meta_description_placeholder": {"const": "{{META_DESCRIPTION}}"},
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["@context", "@type"],
        "properties": {
          "@context": {"const": "https://schema.org"},
          "@type": {"enum": ["Article", "FAQPage", "ItemList"]}
        }
      }
    }
  }
}
