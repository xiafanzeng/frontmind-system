{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/e5-writing-packet-v2.3.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "stage", "primary_question", "pattern_id", "voice_profile",
    "brand_priority_angle", "candidate_contract", "candidate_profiles", "answer_landscape",
    "benchmark_moves", "fact_cards", "sources", "section_assignments", "reader_questions",
    "public_constraints", "medical_or_legal_safety", "forbidden_public_language", "instructions"
  ],
  "properties": {
    "schema_version": {"const": "2.3.0"},
    "job_id": {"type": "string", "pattern": "^job_"},
    "stage": {"const": "E5"},
    "primary_question": {"type": "string", "minLength": 1},
    "pattern_id": {"type": "string", "pattern": "^P(?:0[1-9]|1[0-6])$"},
    "voice_profile": {"type": "object"},
    "brand_priority_angle": {"type": ["object", "string", "null"]},
    "candidate_contract": {"type": ["object", "null"]},
    "candidate_profiles": {"type": "array", "items": {"type": "object"}},
    "answer_landscape": {"type": ["object", "array"]},
    "benchmark_moves": {"type": "array", "items": {"type": ["object", "string"]}},
    "fact_cards": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array", "items": {"type": "object"}},
    "section_assignments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "reader_questions": {"type": "array", "items": {"type": ["object", "string"]}},
    "public_constraints": {"type": "array", "items": {"type": ["object", "string"]}},
    "medical_or_legal_safety": {"type": "array", "items": {"type": ["object", "string"]}},
    "forbidden_public_language": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
