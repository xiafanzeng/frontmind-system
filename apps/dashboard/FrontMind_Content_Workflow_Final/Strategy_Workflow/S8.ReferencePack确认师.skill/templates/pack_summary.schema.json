{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/pack-summary-v2.3.json",
  "title": "FrontMind S8 Pack Confirmation Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "status", "brand", "products_and_services", "promotional_priorities", "qualified_or_prohibited_claims", "voice", "visuals", "question_reference_count", "confirmation_prompt", "warnings"],
  "properties": {
    "schema_version": {"const": "2.3.0"},
    "stage": {"const": "S8_pack_summary"},
    "status": {"const": "awaiting_pack_confirmation"},
    "brand": {"type": "object"},
    "products_and_services": {"type": "array", "items": {"type": "string"}},
    "promotional_priorities": {"type": "array", "minItems": 1},
    "qualified_or_prohibited_claims": {"type": "object"},
    "voice": {"type": "object"},
    "visuals": {"type": "object"},
    "question_reference_count": {"type": "integer", "minimum": 0},
    "confirmation_prompt": {"type": "string", "minLength": 1},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
