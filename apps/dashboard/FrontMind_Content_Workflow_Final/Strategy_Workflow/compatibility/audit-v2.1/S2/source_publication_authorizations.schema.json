{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/source-publication-authorizations-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brand", "authorization_id", "reviewer", "reviewer_role", "reviewed_at", "authorizations"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "brand": {"type": "string", "minLength": 1},
    "authorization_id": {"type": "string", "pattern": "^auth_[a-z0-9][a-z0-9_-]{2,80}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "authorizations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "publication_authorization", "authorization_basis", "evidence_refs", "anonymization_attestation", "notes"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^src_"},
          "publication_authorization": {"enum": ["public_approved", "anonymized_approved", "internal_only"]},
          "authorization_basis": {"type": "string", "minLength": 3},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "anonymization_attestation": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  },
  "allOf": [{
    "properties": {
      "authorizations": {
        "items": {
          "allOf": [{
            "if": {"properties": {"publication_authorization": {"const": "anonymized_approved"}}},
            "then": {"properties": {"anonymization_attestation": {"minLength": 3}}},
            "else": {"properties": {"anonymization_attestation": {"maxLength": 0}}}
          }]
        }
      }
    }
  }]
}
