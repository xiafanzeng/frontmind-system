{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/brand_facts-v2.3.schema.json",
  "title": "FrontMind Brand Facts v2.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "brand_identity", "positioning", "offerings", "capabilities", "proof_points", "limitations"],
  "properties": {
    "schema_version": { "const": "2.3.0" },
    "stage": { "const": "S4_brand_facts" },
    "brand_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_name", "aliases", "source_ids"],
      "properties": {
        "canonical_name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "positioning": {
      "type": "object", "additionalProperties": false,
      "required": ["category_frame", "brand_role", "differentiated_value", "reasons_to_believe", "functional_value", "narrative_hypotheses"],
      "properties": {
        "category_frame": { "type": "string", "minLength": 1 },
        "brand_role": { "type": "string", "minLength": 1 },
        "differentiated_value": { "type": "string", "minLength": 1 },
        "reasons_to_believe": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reason" } },
        "functional_value": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "narrative_hypotheses": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "offerings": { "type": "array", "items": { "$ref": "#/$defs/factItem" } },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/factItem" } },
    "proof_points": { "type": "array", "items": { "$ref": "#/$defs/proof" } },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact_id", "statement", "claim_ids", "source_ids"],
        "properties": {
          "fact_id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "claim_ids": { "$ref": "#/$defs/claimIds" },
          "source_ids": { "$ref": "#/$defs/sourceIds" }
        }
      }
    }
  },
  "$defs": {
    "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^src_" }, "uniqueItems": true },
    "claimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^clm_" }, "uniqueItems": true },
    "reason": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "claim_ids", "source_ids", "usage_status"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "usage_status": { "enum": ["usable", "qualified"] }
      }
    },
    "factItem": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "statement", "claim_ids", "source_ids", "usage_status"],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "usage_status": { "enum": ["usable", "qualified"] }
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["proof_id", "claim", "claim_ids", "source_ids", "knowledge_ids", "evidence_status", "allowed_wording", "necessary_qualification", "applicable_patterns"],
      "properties": {
        "proof_id": { "type": "string", "pattern": "^proof_" },
        "claim": { "type": "string", "minLength": 1 },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "knowledge_ids": { "type": "array", "items": { "type": "string", "pattern": "^kn_" }, "uniqueItems": true },
        "evidence_status": { "enum": ["supported", "qualified"] },
        "allowed_wording": { "type": "string", "minLength": 1 },
        "necessary_qualification": { "type": ["string", "null"] },
        "applicable_patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^P(0[1-9]|1[0-6])$" }, "uniqueItems": true }
      }
    }
  }
}
