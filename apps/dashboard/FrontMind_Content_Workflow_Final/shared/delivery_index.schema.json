{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/delivery_index.schema.json",
  "title": "FrontMind Delivery Index v2.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "created_at", "artifacts", "warnings"],
  "properties": {
    "schema_version": { "const": "2.3.0" },
    "job_id": { "type": "string", "pattern": "^job_" },
    "created_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "media_type"],
        "properties": {
          "role": {
            "enum": [
              "article_body_docx", "article_body_html", "title_options",
              "title_map", "publishing_metadata_map", "structured_data_template", "image"
            ]
          },
          "path": { "$ref": "#/$defs/relativePath" },
          "media_type": { "type": "string", "minLength": 3, "maxLength": 120 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
