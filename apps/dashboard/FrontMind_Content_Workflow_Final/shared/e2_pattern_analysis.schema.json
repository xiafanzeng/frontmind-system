{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/e2_pattern_analysis.schema.json",
  "title": "FrontMind E2 Research and Pattern Recommendation v2.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "question", "entry_category", "product_scenario_subintent",
    "completed_at", "monitoring_summary", "pool_status", "cited_content_pool",
    "content_observations", "recommendation", "warnings"
  ],
  "properties": {
    "schema_version": { "const": "2.3.0" },
    "job_id": { "type": "string", "pattern": "^job_[a-z0-9][a-z0-9_-]{2,80}$" },
    "question": { "type": "string", "minLength": 1, "maxLength": 500 },
    "entry_category": { "$ref": "#/$defs/contentEntry" },
    "product_scenario_subintent": { "type": ["string", "null"] },
    "completed_at": { "type": "string", "format": "date-time" },
    "monitoring_summary": { "$ref": "#/$defs/monitoringSummary" },
    "pool_status": { "enum": ["complete_pool", "partial_pool", "not_applicable"] },
    "cited_content_pool": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/poolItem" } },
    "content_observations": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/contentObservation" } },
    "recommendation": { "$ref": "#/$defs/recommendation" },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "contentEntry": { "enum": ["industry_ranking", "competitor_comparison", "reputation", "product_scenario", "foundation_start"] },
    "patternId": { "type": "string", "pattern": "^P(?:0[1-9]|1[0-6])$" },
    "monitoringSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["answer_count", "platforms", "mentioned_entities", "candidate_order_signals", "recurring_dimensions", "recurring_subquestions", "unanswered_subquestions"],
      "properties": {
        "answer_count": { "type": "integer", "minimum": 1 },
        "platforms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "mentioned_entities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "candidate_order_signals": { "type": "array", "items": { "type": "object" } },
        "recurring_dimensions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "recurring_subquestions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "unanswered_subquestions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "poolItem": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_rank", "content_title", "canonical_url", "media_name", "media_domain", "citation_date", "citation_count", "citation_share", "detailed_row_refs"],
      "properties": {
        "raw_rank": { "type": "integer", "minimum": 1, "maximum": 20 },
        "content_title": { "type": "string", "minLength": 1 },
        "canonical_url": { "type": "string", "format": "uri" },
        "media_name": { "type": ["string", "null"] },
        "media_domain": { "type": ["string", "null"] },
        "citation_date": { "type": ["string", "null"] },
        "citation_count": { "type": "integer", "minimum": 0 },
        "citation_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "detailed_row_refs": { "type": "array", "items": { "type": "integer", "minimum": 2 }, "uniqueItems": true }
      }
    },
    "contentObservation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "observation_id", "raw_rank", "status", "content_form", "primary_pattern_id",
        "alternative_pattern_ids", "classification_confidence", "matched_intent_signal_ids",
        "matched_structure_component_ids", "negative_signal_ids", "question_similarity",
        "classification_rationale", "structure_summary", "benchmark_review", "notes"
      ],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "raw_rank": { "type": "integer", "minimum": 1, "maximum": 20 },
        "status": { "enum": ["classified_article", "non_article", "unavailable", "duplicate_alias", "unsafe_url"] },
        "content_form": { "type": ["string", "null"] },
        "primary_pattern_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/patternId" }] },
        "alternative_pattern_ids": { "type": "array", "items": { "$ref": "#/$defs/patternId" }, "uniqueItems": true },
        "classification_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "matched_intent_signal_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "matched_structure_component_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "negative_signal_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "question_similarity": { "type": "number", "minimum": 0, "maximum": 1 },
        "classification_rationale": { "type": ["string", "null"], "maxLength": 2000 },
        "structure_summary": { "type": ["string", "null"], "maxLength": 4000 },
        "benchmark_review": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/benchmarkReview" }
          ]
        },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "classified_article" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "content_form": {
                "enum": [
                  "editorial_article", "brand_feature", "news_article", "comparison_review",
                  "tutorial_documentation", "case_study", "research_pdf", "official_longform"
                ]
              },
              "primary_pattern_id": { "$ref": "#/$defs/patternId" },
              "classification_confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "classification_rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "structure_summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
            }
          },
          "else": {
            "properties": {
              "primary_pattern_id": { "type": "null" },
              "alternative_pattern_ids": { "maxItems": 0 },
              "classification_confidence": { "const": 0 },
              "matched_intent_signal_ids": { "maxItems": 0 },
              "matched_structure_component_ids": { "maxItems": 0 },
              "negative_signal_ids": { "maxItems": 0 },
              "benchmark_review": { "type": "null" }
            }
          }
        }
      ]
    },
    "benchmarkReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id", "structure_observation", "subquestions_observed",
        "evidence_positions_observed", "visual_observation", "faq_observation",
        "strengths", "weaknesses", "do_not_copy", "selection_rationale",
        "research_note"
      ],
      "properties": {
        "benchmark_id": { "type": "string", "pattern": "^P(?:0[1-9]|1[0-6])-B[0-9]{2}$" },
        "structure_observation": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }, "uniqueItems": true
        },
        "subquestions_observed": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }, "uniqueItems": true
        },
        "evidence_positions_observed": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }, "uniqueItems": true
        },
        "visual_observation": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }, "uniqueItems": true
        },
        "faq_observation": { "type": "string", "minLength": 1 },
        "strengths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }, "uniqueItems": true
        },
        "weaknesses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }, "uniqueItems": true
        },
        "do_not_copy": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }, "uniqueItems": true
        },
        "selection_rationale": { "type": "string", "minLength": 1 },
        "research_note": { "type": "string", "minLength": 1 }
      }
    },
    "distributionItem": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern_id", "weighted_support", "weighted_share", "article_count", "average_rank", "question_trigger_score", "supporting_ranks"],
      "properties": {
        "pattern_id": { "$ref": "#/$defs/patternId" },
        "weighted_support": { "type": "number", "minimum": 0 },
        "weighted_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "article_count": { "type": "integer", "minimum": 0 },
        "average_rank": { "type": ["number", "null"], "minimum": 1, "maximum": 20 },
        "question_trigger_score": { "type": "number", "minimum": 0 },
        "supporting_ranks": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 20 }, "uniqueItems": true }
      }
    },
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "recommended_pattern_id", "alternative_pattern_ids", "weighted_distribution",
        "unweighted_distribution", "supporting_content_ranks", "contradicting_content_ranks",
        "classification_coverage", "rationale", "advisory_only"
      ],
      "properties": {
        "status": { "enum": ["evidence_supported", "partial_support"] },
        "recommended_pattern_id": { "$ref": "#/$defs/patternId" },
        "alternative_pattern_ids": { "type": "array", "items": { "$ref": "#/$defs/patternId" }, "uniqueItems": true },
        "weighted_distribution": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/distributionItem" } },
        "unweighted_distribution": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/distributionItem" } },
        "supporting_content_ranks": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 20 }, "uniqueItems": true },
        "contradicting_content_ranks": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 20 }, "uniqueItems": true },
        "classification_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "advisory_only": { "const": true }
      }
    }
  }
}
