{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/information-evidence-architecture-v2.3.json",
  "title": "FrontMind Information and Evidence Architecture v2.3",
  "description": "A content-bearing strategy asset. Proof links cover important publishable facts; this is not an approval or fingerprint ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stage", "brand", "positioning", "information_pillars",
    "differentiation_evidence_map", "proof_bundles", "brand_priority_angles",
    "comparison_boundary", "publication_boundary", "entry_guidance", "research_gaps"
  ],
  "properties": {
    "schema_version": { "const": "2.3.0" },
    "stage": { "const": "S4_information_evidence_architecture" },
    "brand": { "type": "string", "minLength": 1 },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_frame", "brand_role", "differentiated_value", "reasons_to_believe", "functional_value", "narrative_hypotheses"],
      "properties": {
        "category_frame": { "type": "string", "minLength": 1 },
        "brand_role": { "type": "string", "minLength": 1 },
        "differentiated_value": { "type": "string", "minLength": 1 },
        "reasons_to_believe": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reasonToBelieve" } },
        "functional_value": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "narrative_hypotheses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "information_pillars": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pillar_id", "name", "core_message", "proof_refs"],
        "properties": {
          "pillar_id": { "type": "string", "pattern": "^pillar_[a-z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "core_message": { "type": "string", "minLength": 1 },
          "proof_refs": { "$ref": "#/$defs/proofRefs" }
        }
      }
    },
    "differentiation_evidence_map": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension_id", "dimension", "brand_fact", "evidence_status", "proof_refs", "comparison_allowed", "allowed_wording", "forbidden_inference"],
        "properties": {
          "dimension_id": { "type": "string", "pattern": "^dimension_[a-z0-9_-]+$" },
          "dimension": { "type": "string", "minLength": 1 },
          "brand_fact": { "type": "string", "minLength": 1 },
          "evidence_status": { "enum": ["supported", "qualified"] },
          "proof_refs": { "$ref": "#/$defs/proofRefs" },
          "comparison_allowed": { "type": "boolean" },
          "allowed_wording": { "type": "string", "minLength": 1 },
          "forbidden_inference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "proof_bundles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/proofBundle" } },
    "brand_priority_angles": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["angle_id", "priority_message", "editorial_role", "trigger_conditions", "eligible_entry_categories", "eligible_pattern_ids", "proof_refs", "claim_ids", "source_ids"],
        "properties": {
          "angle_id": { "type": "string", "pattern": "^angle_[a-z0-9_-]+$" },
          "priority_message": { "type": "string", "minLength": 1 },
          "editorial_role": { "type": "string", "minLength": 1 },
          "trigger_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "eligible_entry_categories": { "$ref": "#/$defs/entries" },
          "eligible_pattern_ids": { "$ref": "#/$defs/patternIds" },
          "proof_refs": { "$ref": "#/$defs/proofRefs" },
          "claim_ids": { "$ref": "#/$defs/claimIds" },
          "source_ids": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "comparison_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "client_first_rule", "prohibited"],
      "properties": {
        "allowed": { "type": "string", "minLength": 1 },
        "client_first_rule": { "type": "string", "minLength": 1 },
        "prohibited": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "publication_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["first_party_can_support", "first_party_cannot_alone_support"],
      "properties": {
        "first_party_can_support": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "first_party_cannot_alone_support": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "entry_guidance": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entry_category", "entry_label", "eligible_patterns", "brand_priority_angle_ids"],
        "properties": {
          "entry_category": { "$ref": "#/$defs/entry" },
          "entry_label": { "type": "string", "minLength": 1 },
          "eligible_patterns": { "$ref": "#/$defs/patternIds" },
          "brand_priority_angle_ids": { "type": "array", "items": { "type": "string", "pattern": "^angle_" }, "uniqueItems": true }
        }
      }
    },
    "research_gaps": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "entry": { "enum": ["industry_ranking", "competitor_comparison", "reputation", "product_scenario", "foundation_start"] },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" }, "uniqueItems": true },
    "patternIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^P(0[1-9]|1[0-6])$" }, "uniqueItems": true },
    "claimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^clm_" }, "uniqueItems": true },
    "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^src_" }, "uniqueItems": true },
    "proofRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^proof_" }, "uniqueItems": true },
    "reasonToBelieve": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "claim_ids", "source_ids", "usage_status"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "usage_status": { "enum": ["usable", "qualified"] }
      }
    },
    "proofBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["proof_id", "claim", "claim_ids", "source_ids", "knowledge_ids", "evidence_status", "allowed_wording", "necessary_qualification", "applicable_patterns"],
      "properties": {
        "proof_id": { "type": "string", "pattern": "^proof_[a-z0-9_-]+$" },
        "claim": { "type": "string", "minLength": 1 },
        "claim_ids": { "$ref": "#/$defs/claimIds" },
        "source_ids": { "$ref": "#/$defs/sourceIds" },
        "knowledge_ids": { "type": "array", "items": { "type": "string", "pattern": "^kn_" }, "uniqueItems": true },
        "evidence_status": { "enum": ["supported", "qualified"] },
        "allowed_wording": { "type": "string", "minLength": 1 },
        "necessary_qualification": { "type": ["string", "null"] },
        "applicable_patterns": { "$ref": "#/$defs/patternIds" }
      }
    }
  }
}
