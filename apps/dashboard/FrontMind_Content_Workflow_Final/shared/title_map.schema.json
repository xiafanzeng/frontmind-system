{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/title_map.schema.json",
  "title": "FrontMind Title Map v2.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "requested_count", "generated_at", "options"],
  "properties": {
    "schema_version": { "const": "2.3.0" },
    "job_id": { "type": "string", "pattern": "^job_" },
    "requested_count": { "type": "integer", "minimum": 1, "maximum": 20 },
    "generated_at": { "type": "string", "format": "date-time" },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title_id", "title_text", "h1_suggestion", "meta_description", "title_formula", "angle_tag", "temporal_basis", "referenced_entity_names"],
        "properties": {
          "title_id": { "type": "string", "pattern": "^title_[a-z0-9_-]+$" },
          "title_text": { "type": "string", "minLength": 1, "maxLength": 120 },
          "h1_suggestion": { "type": "string", "minLength": 1, "maxLength": 160 },
          "meta_description": { "type": "string", "minLength": 35, "maxLength": 160 },
          "title_formula": { "type": "string", "minLength": 1, "maxLength": 500 },
          "angle_tag": { "type": "string", "minLength": 1, "maxLength": 100 },
          "temporal_basis": { "type": ["string", "null"], "maxLength": 160 },
          "referenced_entity_names": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
