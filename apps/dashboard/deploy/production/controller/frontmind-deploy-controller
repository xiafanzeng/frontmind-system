  contract_0065_job_output="$(mktemp "${STATE_DIR}/contract-0065-output.XXXXXX")" \
    || return 1
  contract_0065_expected_applied_count="$applied_count"
  contract_0065_expected_applied_journal_hash="$applied_hash"
  contract_0065_migration_container_absent || return 1
  start_contract_0065_job timeout --foreground --signal=TERM --kill-after=10s \
    "${RELEASE_DB_MIGRATE_TIMEOUT_SECONDS}s" docker compose \
    --project-directory "$COMPOSE_DIR" \
    --env-file "$environment_file" \
    -f "$COMPOSE_FILE" \
    --profile release run --rm --no-deps \
    --name "$SITEOPS_ALIDNS_OAUTH_MIGRATION_CONTAINER" \
    --label "net.frontmind.environment=production" \
    --label "net.frontmind.resource=${SITEOPS_ALIDNS_OAUTH_MIGRATION_RESOURCE}" \
    --label "net.frontmind.controller=${SITEOPS_ALIDNS_OAUTH_MIGRATION_CONTROLLER}" \
    --label "net.frontmind.release-id=${release_id}" \
    release-db-migrate migrate \
    --release-id "$release_id" \
    --expected-applied-count "$applied_count" \
    --expected-applied-journal-hash "$applied_hash" \
    --allow-contract --json >"$contract_0065_job_output" \
    || status=$?
  if (( status == 0 )); then
    wait_for_contract_0065_job || status=$?
  fi
  output="$(<"$contract_0065_job_output")"
  rm -f -- "$contract_0065_job_output" || status=1
  contract_0065_job_output=""
  stop_contract_0065_migration_container || status=1
  json="$(printf '%s\n' "$output" | tail -n 1)"
  if (( status != 0 )); then
    if jq -e 'type == "object"' <<<"$json" >/dev/null 2>&1; then
      contract_0065_json_output="$json"
    else
      printf '%s\n' "$output" >&2
    fi
    return "$status"
  fi
  jq -e 'type == "object"' <<<"$json" >/dev/null || {
    printf '%s\n' "$output" >&2
    return 1
  }
  contract_0065_json_output="$json"
}

