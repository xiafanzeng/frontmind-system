terminate_contract_0065_job() {
  local pid="${contract_0065_job_pid:-}" pgid="${contract_0065_job_pgid:-}" attempt
  if [[ -n $pid ]]; then
    [[ $pid =~ ^[0-9]+$ && $pgid =~ ^[0-9]+$ ]] || return 1
    kill -TERM -- "-${pgid}" >/dev/null 2>&1 || true
    for attempt in {1..20}; do
      kill -0 -- "-${pgid}" >/dev/null 2>&1 || break
      sleep 0.1
    done
    if kill -0 -- "-${pgid}" >/dev/null 2>&1; then
      kill -KILL -- "-${pgid}" >/dev/null 2>&1 || return 1
    fi
    for attempt in {1..20}; do
      kill -0 -- "-${pgid}" >/dev/null 2>&1 || break
      sleep 0.1
    done
    kill -0 -- "-${pgid}" >/dev/null 2>&1 && return 1
    wait "$pid" >/dev/null 2>&1 || true
    contract_0065_job_pid=""
    contract_0065_job_pgid=""
  fi
  stop_contract_0065_migration_container
}

start_contract_0065_job() {
  local start_status=0 pgid="" trailing=""
  [[ -z $contract_0065_job_pid && -z $contract_0065_job_pgid ]] || return 1
  contract_0065_job_start_signal=""
  contract_0065_job_ack_file="$(mktemp "${STATE_DIR}/contract-0065-job.XXXXXX")" \
    || return 1
  chmod 0600 "$contract_0065_job_ack_file" || return 1
  trap 'contract_0065_job_start_signal="INT"' INT
  trap 'contract_0065_job_start_signal="TERM"' TERM
  trap 'contract_0065_job_start_signal="HUP"' HUP
  setsid --fork --wait /bin/bash -c '
    ack_file=$1
    shift
    printf "%s\n" "${BASHPID:-$$}" >"$ack_file" || exit 125
    exec "$@"
  ' frontmind-production-contract-0065 "$contract_0065_job_ack_file" "$@" &
  contract_0065_job_pid=$!
  while [[ ! -s $contract_0065_job_ack_file ]]; do
    if ! kill -0 "$contract_0065_job_pid" >/dev/null 2>&1; then
      wait "$contract_0065_job_pid" || start_status=$?
      contract_0065_job_pid=""
      rm -f -- "$contract_0065_job_ack_file" || true
      contract_0065_job_ack_file=""
      trap 'handle_controller_signal INT 130' INT
      trap 'handle_controller_signal TERM 143' TERM
      trap 'handle_controller_signal HUP 129' HUP
      (( start_status != 0 )) || start_status=1
      return "$start_status"
    fi
    sleep 0.01
  done
  {
    IFS= read -r pgid || start_status=$?
    if IFS= read -r trailing; then start_status=1; fi
  } <"$contract_0065_job_ack_file"
  rm -f -- "$contract_0065_job_ack_file" || start_status=1
  contract_0065_job_ack_file=""
  [[ $pgid =~ ^[0-9]+$ && -z $trailing ]] || start_status=1
  contract_0065_job_pgid="$pgid"
  trap 'handle_controller_signal INT 130' INT
  trap 'handle_controller_signal TERM 143' TERM
  trap 'handle_controller_signal HUP 129' HUP
  if (( start_status != 0 )); then
    terminate_contract_0065_job || true
    return "$start_status"
  fi
  case "$contract_0065_job_start_signal" in
    INT) handle_controller_signal INT 130 ;;
    TERM) handle_controller_signal TERM 143 ;;
    HUP) handle_controller_signal HUP 129 ;;
  esac
}

wait_for_contract_0065_job() {
  local status=0
  [[ $contract_0065_job_pid =~ ^[0-9]+$ && \
     $contract_0065_job_pgid =~ ^[0-9]+$ ]] || return 1
