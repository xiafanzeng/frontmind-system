restore_coupled_stack() {
  local old_dashboard_digest old_dashboard_previous old_dashboard_source
  local old_dashboard_journal old_dashboard_deployed old_dashboard_image
  local old_website_digest old_website_previous old_website_source
  local old_website_deployed old_website_image
  local dashboard_runtime_sha website_runtime_sha backup restore_required
  local release_id quarantine_reason
  local persisted_status persisted_message
  local dashboard_restore_env website_restore_env deadline current_old_ready=0
  (( coupled_stack_restore_running == 1 )) || coupled_stack_restore_running=1
  config_is_root_only "$COUPLED_STACK_CAPSULE_FILE" || return 1
  jq -e '
    .schemaVersion == 1 and
    (.dashboard.oldDigest | test("^sha256:[a-f0-9]{64}$")) and
    (.dashboard.oldSourceSha | test("^[a-f0-9]{40}$")) and
    (.dashboard.runtimeRollbackSha256 | test("^[a-f0-9]{64}$")) and
    (.dashboard.releaseId | type == "string") and
    (.dashboard.quarantineReason | type == "string") and
    (.dashboard.databaseRestoreRequired | type == "boolean") and
    (.website.oldDigest | test("^sha256:[a-f0-9]{64}$")) and
    (.website.oldSourceSha | test("^[a-f0-9]{40}$")) and
    (.website.runtimeRollbackSha256 | test("^[a-f0-9]{64}$"))
  ' "$COUPLED_STACK_CAPSULE_FILE" >/dev/null || return 1
  old_dashboard_digest="$(jq -r '.dashboard.oldDigest' "$COUPLED_STACK_CAPSULE_FILE")"
  old_dashboard_previous="$(jq -r '.dashboard.oldPreviousDigest' "$COUPLED_STACK_CAPSULE_FILE")"
  old_dashboard_source="$(jq -r '.dashboard.oldSourceSha' "$COUPLED_STACK_CAPSULE_FILE")"
  old_dashboard_journal="$(jq -r '.dashboard.oldJournalHash' "$COUPLED_STACK_CAPSULE_FILE")"
  old_dashboard_deployed="$(jq -r '.dashboard.oldDeployedAt' "$COUPLED_STACK_CAPSULE_FILE")"
  old_dashboard_image="${IMAGE_REPOSITORY}@${old_dashboard_digest}"
  restore_required="$(jq -r '.dashboard.databaseRestoreRequired' "$COUPLED_STACK_CAPSULE_FILE")"
  backup="$(jq -r '.dashboard.backupFile' "$COUPLED_STACK_CAPSULE_FILE")"
  release_id="$(jq -r '.dashboard.releaseId' "$COUPLED_STACK_CAPSULE_FILE")"
  quarantine_reason="$(jq -r '.dashboard.quarantineReason' \
    "$COUPLED_STACK_CAPSULE_FILE")"
  persisted_status="$(jq -r '.lastResult.status // ""' "$state_file")"
  persisted_message="$(jq -r '.lastResult.message // ""' "$state_file")"
  if [[ $persisted_status == "quarantined" && \
        $persisted_message == migration-applied-fact-changed-* ]]; then
    restore_required="false"
    quarantine_reason="$persisted_message"
    release_id="$(jq -r '.lastResult.releaseId // ""' "$state_file")"
    backup="$(jq -r '.lastResult.backupFile // ""' "$state_file")"
  fi
  old_website_digest="$(jq -r '.website.oldDigest' "$COUPLED_STACK_CAPSULE_FILE")"
  old_website_previous="$(jq -r '.website.oldPreviousDigest' "$COUPLED_STACK_CAPSULE_FILE")"
  old_website_source="$(jq -r '.website.oldSourceSha' "$COUPLED_STACK_CAPSULE_FILE")"
  old_website_deployed="$(jq -r '.website.oldDeployedAt' "$COUPLED_STACK_CAPSULE_FILE")"
  old_website_image="${COUPLED_WEBSITE_IMAGE_REPOSITORY}@${old_website_digest}"
  dashboard_runtime_sha="$(jq -r '.dashboard.runtimeRollbackSha256' \
    "$COUPLED_STACK_CAPSULE_FILE")"
  website_runtime_sha="$(jq -r '.website.runtimeRollbackSha256' \
    "$COUPLED_STACK_CAPSULE_FILE")"
  normalize_coupled_runtime_rollback \
    "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" \
    "$COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV" \
    "$dashboard_runtime_sha" \
    || return 1
  normalize_coupled_runtime_rollback \
    "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" \
    "$COUPLED_WEBSITE_RUNTIME_RETIRING_ENV" \
    "$website_runtime_sha" \
    || return 1
  website_restore_env="$(mktemp)" || return 1
  make_coupled_website_env "$website_restore_env" "$old_website_image" || return 1
  coupled_website_compose "$website_restore_env" stop website >/dev/null 2>&1 || true
  atomic_copy \
    "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" "$COUPLED_DASHBOARD_RUNTIME_ENV_FILE" \
    || return 1
  atomic_copy "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" "$COUPLED_WEBSITE_RUNTIME_ENV_FILE" \
    || return 1
  dashboard_restore_env="$(mktemp)" || return 1
  make_compose_env "$dashboard_restore_env" "$old_dashboard_image" || return 1
  deadline=$((SECONDS + 20))
  if wait_until_ready "$old_dashboard_source" "$old_dashboard_digest" "$deadline"; then
    current_old_ready=1
  fi
  if (( current_old_ready == 0 )); then
    stop_application_runtime "$dashboard_restore_env" >/dev/null 2>&1 || true
    if [[ $restore_required == "true" ]]; then
      [[ -n $backup && -f $backup && ! -L $backup ]] || return 1
      restore_production_database "$backup" || return 1
    elif [[ $restore_required != "false" ]]; then
      return 1
    fi
    deadline=$((SECONDS + DEPLOY_TIMEOUT_SECONDS))
    start_application_runtime \
      "$dashboard_restore_env" "$old_dashboard_image" "$deadline" || return 1
    wait_until_ready "$old_dashboard_source" "$old_dashboard_digest" "$deadline" \
      || return 1
  fi
  write_dashboard_active_env_exact "$old_dashboard_image" "$old_dashboard_source" \
    || return 1
  if [[ -n $quarantine_reason ]]; then
    [[ $release_id =~ ^[a-f0-9]{40}-[0-9]{8}T[0-9]{6}Z$ && \
       -n $backup && -f $backup && ! -L $backup ]] || return 1
    write_state \
      "$old_dashboard_digest" "$old_dashboard_previous" "$old_dashboard_source" \
      "$old_dashboard_journal" "$old_dashboard_deployed" \
      "quarantined" "$quarantine_reason" "$digest" "$release_id" "$backup" \
      || return 1
  else
    write_state \
      "$old_dashboard_digest" "$old_dashboard_previous" "$old_dashboard_source" \
      "$old_dashboard_journal" "$old_dashboard_deployed" \
      "success" "coupled-stack-previous-restored" "$old_dashboard_digest" \
      || return 1
  fi
  deadline=$((SECONDS + DEPLOY_TIMEOUT_SECONDS))
  coupled_website_compose "$website_restore_env" \
    up -d --no-deps --force-recreate website || return 1
  wait_coupled_website_ready \
    "$old_website_source" "$old_website_digest" "$deadline" || return 1
  write_coupled_website_active_env "$old_website_image" "$old_website_source" \
    || return 1
  write_coupled_website_state \
    "$old_website_digest" "$old_website_previous" "$old_website_source" \
    "$old_website_deployed" "coupled-stack-previous-restored" || return 1
  rm -f -- "$dashboard_restore_env" "$website_restore_env" || return 1
  commit_coupled_stack_capsule_cleanup || return 1
  coupled_stack_restore_armed=0
  log "PRODUCTION_COUPLED_STACK_BOTH_PREVIOUS_RESTORED dashboardSource=${old_dashboard_source} websiteSource=${old_website_source}"
}

deploy_coupled_website_and_finalize() {
  local old_website_digest old_website_source deadline deployed_at
  (( coupled_stack_mode == 1 )) || return 0
  config_is_root_only "$COUPLED_STACK_CAPSULE_FILE" || return 1
  old_website_digest="$(jq -r '.website.oldDigest' "$COUPLED_STACK_CAPSULE_FILE")"
  old_website_source="$(jq -r '.website.oldSourceSha' "$COUPLED_STACK_CAPSULE_FILE")"
  dashboard_health_and_changed_surface_once || return 1
  [[ -z $coupled_website_env ]] || rm -f -- "$coupled_website_env" || return 1
  coupled_website_env="$(mktemp)" || return 1
  make_coupled_website_env "$coupled_website_env" "$coupled_website_image" || return 1
  deadline=$((SECONDS + DEPLOY_TIMEOUT_SECONDS))
  coupled_website_compose "$coupled_website_env" \
    up -d --no-deps --force-recreate website || return 1
  wait_coupled_website_ready \
    "$coupled_website_source_sha" "$coupled_website_digest" "$deadline" || return 1
  coupled_website_health_once || return 1
  write_coupled_website_active_env \
    "$coupled_website_image" "$coupled_website_source_sha" || return 1
  deployed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_coupled_website_state \
    "$coupled_website_digest" "$old_website_digest" \
    "$coupled_website_source_sha" "$deployed_at" "coupled-stack-ready" || return 1
  commit_coupled_stack_capsule_cleanup || return 1
  coupled_stack_restore_armed=0
  log "PRODUCTION_COUPLED_STACK_SUCCESS dashboardSource=${source_sha} websiteSource=${coupled_website_source_sha}"
}

if [[ $operation == "deploy" && $mode == "acknowledge-incident" ]]; then
  [[ $unfinished_attempted_digest == "$digest" ]] \
    || die "INCIDENT_ACKNOWLEDGEMENT_DIGEST_MISMATCH" 64
  [[ -n $unfinished_release_id && $unfinished_release_id == "${source_sha}-"* ]] \
    || die "INCIDENT_ACKNOWLEDGEMENT_RELEASE_MISMATCH" 64
  [[ -n $unfinished_backup_file && -f $unfinished_backup_file ]] \
    || die "INCIDENT_ACKNOWLEDGEMENT_BACKUP_MISSING" 75
  write_state \
    "$current_digest" "$previous_digest" "$current_source_sha" \
    "$current_journal_hash" "$current_deployed_at" \
    "incident_acknowledged" "root-authorized-new-attempt" "$digest" \
    "$unfinished_release_id" "$unfinished_backup_file"
  log "DEPLOY_INCIDENT_ACKNOWLEDGED service=${service} release=${unfinished_release_id} digest=${digest}; no database or application command executed"
  exit 0
fi

if (( coupled_stack_mode == 1 )); then
  if [[ -e $COUPLED_STACK_CAPSULE_FILE || -L $COUPLED_STACK_CAPSULE_FILE ]]; then
    coupled_stack_restore_armed=1
    coupled_stack_restore_running=1
    restore_coupled_stack \
      || die "PRODUCTION_COUPLED_STACK_INTERRUPTED_RESTORE_FAILED" 75
    coupled_stack_restore_running=0
    coupled_recovery_pending=0
    current_digest="$(jq -r '.currentDigest' "$state_file")"
    previous_digest="$(jq -r '.previousDigest' "$state_file")"
    current_source_sha="$(jq -r '.sourceSha' "$state_file")"
    current_journal_hash="$(jq -r '.journalHash' "$state_file")"
    current_deployed_at="$(jq -r '.deployedAt' "$state_file")"
    unfinished_status="$(jq -r '.lastResult.status // ""' "$state_file")"
    unfinished_attempted_digest="$(jq -r '.lastResult.attemptedDigest // ""' "$state_file")"
    unfinished_release_id="$(jq -r '.lastResult.releaseId // ""' "$state_file")"
    unfinished_backup_file="$(jq -r '.lastResult.backupFile // ""' "$state_file")"
    rollback_digest="$current_digest"
    rollback_source_sha="$current_source_sha"
    if [[ $unfinished_status == "quarantined" ]]; then
      die "DEPLOY_INCIDENT_QUARANTINED_REQUIRES_ROOT_ACKNOWLEDGEMENT" 75
    fi
  fi
fi

if [[ $mode == "deploy" && ${SUDO_USER:-} == "frontmind-deploy" ]]; then
  read_ephemeral_registry_auth
fi
verify_candidate
verify_coupled_website_candidate
if [[ -n $registry_auth_dir ]]; then
  cleanup_ephemeral_registry_auth || die "REGISTRY_AUTH_CLEANUP_FAILED"
fi

candidate_env="$(mktemp)"
make_compose_env "$candidate_env" "$image"

if [[ $mode != "bootstrap-state" ]]; then
  seed_static_template_catalog "$candidate_env" \
    || die "PRODUCTION_STATIC_TEMPLATE_CATALOG_SEED_FAILED" 78
fi

if (( coupled_stack_mode == 1 )); then
  prepare_coupled_stack \
    || die "PRODUCTION_COUPLED_STACK_PREPARE_FAILED" 75
fi

if [[ $mode == "bootstrap-state" ]]; then
  # Bootstrap only records an already-running, signed release. It never starts
  # a container or invokes release-db, backup, restore, or migration commands.
  # The first normal successful deployment rotates this digest into previous.
  assert_candidate_is_active "$candidate_env"
  bootstrap_deadline=$((SECONDS + DEPLOY_TIMEOUT_SECONDS))
  if ! wait_until_ready "$source_sha" "$digest" "$bootstrap_deadline"; then
    die "BOOTSTRAP_CURRENT_NOT_READY" 75
  fi
  if [[ $service == "dashboard" ]]; then
    journal_hash="$(jq -r '.migration.journalHash // ""' <<<"$LAST_READY_PAYLOAD")"
    [[ $journal_hash =~ ^[a-f0-9]{64}$ ]] || die "BOOTSTRAP_READY_JOURNAL_HASH_INVALID"
  else
    journal_hash="not-applicable"
  fi
  write_active_image_env "$image"
  deployed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_state \
    "$digest" "" "$source_sha" "$journal_hash" "$deployed_at" \
    "success" "bootstrap-current" "$digest"
  rotate_service_images "$digest" ""
  log "BOOTSTRAP_STATE_SUCCESS service=${service} current=${digest} previous=empty source=${source_sha}"
  exit 0
fi

if (( initial_signed_takeover == 1 )); then
  # This path is the only automatic way to establish a missing state file. It
  # can replace only an already-running service whose image label and local /
  # public readiness identities agree with each other. The old source SHA may
  # differ from the signed candidate revision. Dashboard accepts an exact
  # ledger and exact schema only; pending migrations are intentionally blocked
  # before backup or migration code is reachable.
  log "INITIAL_SIGNED_TAKEOVER_PREFLIGHT service=${service} source=${source_sha}"
  capture_initial_runtime "$candidate_env"
  initial_runtime_env="$(mktemp)"
  make_initial_runtime_env "$initial_runtime_env" \
    || die "INITIAL_TAKEOVER_RUNTIME_ENV_CAPTURE_FAILED" 73

  journal_hash="not-applicable"
  if [[ $service == "dashboard" ]]; then
    log "INITIAL_SIGNED_TAKEOVER_DATABASE_PLAN_START"
    initial_plan_json="$(run_release_db_json "$candidate_env" plan --json)" \
      || die "INITIAL_TAKEOVER_DATABASE_PLAN_FAILED" 78
    initial_plan_status="$(jq -r '.status // "missing"' <<<"$initial_plan_json")"
    initial_schema_status="$(jq -r '.schema.status // "missing"' <<<"$initial_plan_json")"
    if [[ $initial_plan_status != "exact" ]]; then
      die "INITIAL_TAKEOVER_DATABASE_NOT_EXACT:${initial_plan_status}" 78
    fi
    if [[ $initial_schema_status != "exact" ]]; then
      die "INITIAL_TAKEOVER_DATABASE_SCHEMA_NOT_EXACT:${initial_schema_status}" 78
    fi
    journal_hash="$(jq -r '.journalHash // .expected.journalHash // ""' \
      <<<"$initial_plan_json")"
    [[ $journal_hash =~ ^[a-f0-9]{64}$ ]] \
      || die "INITIAL_TAKEOVER_JOURNAL_HASH_INVALID" 78
  fi

  log "INITIAL_SIGNED_TAKEOVER_ROLLOUT_START service=${service}"
  initial_rollout_deadline=$((SECONDS + DEPLOY_TIMEOUT_SECONDS))
  initial_candidate_deadline=$((SECONDS + CANDIDATE_READY_BUDGET_SECONDS))
  if ! roll_out \
    "$candidate_env" "$source_sha" "$digest" "$initial_candidate_deadline"; then
    log "INITIAL_SIGNED_TAKEOVER_CANDIDATE_FAILED"
    if restore_initial_runtime "$candidate_env" "$initial_rollout_deadline"; then
      die "INITIAL_SIGNED_TAKEOVER_FAILED_PREVIOUS_RUNTIME_RESTORED" 75
    fi
    die "INITIAL_SIGNED_TAKEOVER_FAILED_ROLLBACK_UNPROVEN" 75
  fi

  if [[ -e $state_file || -L $state_file ]]; then
    if restore_initial_runtime "$candidate_env" "$initial_rollout_deadline"; then
      die "INITIAL_SIGNED_TAKEOVER_STATE_APPEARED_PREVIOUS_RUNTIME_RESTORED" 75
    fi
    die "INITIAL_SIGNED_TAKEOVER_STATE_APPEARED_ROLLBACK_UNPROVEN" 75
  fi
  write_active_image_env "$image"
  deployed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_state \
    "$digest" "" "$source_sha" "$journal_hash" "$deployed_at" \
    "success" "initial-signed-takeover" "$digest"
  rotate_service_images "$digest" ""
  log "INITIAL_SIGNED_TAKEOVER_SUCCESS service=${service} current=${digest} previous=empty source=${source_sha}"
  exit 0
fi

journal_hash="not-applicable"
database_changed=0
backup_file=""
siteops_alidns_oauth_contract=0

if [[ $service == "dashboard" ]]; then
  log "DATABASE_PLAN_START"
  plan_json="$(run_release_db_json "$candidate_env" plan --json)" || {
    if [[ $unfinished_status == "in_progress" ]]; then
      # A read failure is not evidence that the interrupted migration failed.
      # Keep the only durable releaseId/backupFile facts intact and leave the
      # application stopped. A later invocation for the same digest must begin
      # with this same read-only reconciliation and can never treat pending as
      # authorization for another migrate command.
      die "UNFINISHED_RELEASE_PLAN_UNAVAILABLE_STATE_PRESERVED" 75
    fi
    record_failure "database-plan-failed"
    rotate_service_images "$current_digest" "$previous_digest"
    die "DATABASE_PLAN_FAILED"
  }
  plan_status="$(jq -r '.status' <<<"$plan_json")"
  plan_schema_status="$(jq -r '.schema.status // "missing"' <<<"$plan_json")"
  journal_hash="$(jq -r '.journalHash // .expected.journalHash // ""' <<<"$plan_json")"
  if siteops_alidns_oauth_contract_plan_matches "$plan_json"; then
    siteops_alidns_oauth_contract=1
  elif [[ $unfinished_message =~ ^contract-0065-(migration-(started|complete)|restore-started)$ ]] \
    && siteops_alidns_oauth_exact_state_matches "$plan_json" plan; then
    siteops_alidns_oauth_contract=1
  fi

  # An interrupted migration is reconciled from facts before any new attempt:
  # exact means the prior one-shot job committed and rollout may resume;
  # every other state restores the verified backup. A pending ledger alone is
  # not proof that MySQL DDL never started, so the controller never reruns it.
  if [[ $unfinished_status == "in_progress" && \
        $unfinished_message =~ ^contract-0065-prewrite-(stop-started|backup-complete)$ ]]; then
    siteops_alidns_oauth_contract_plan_matches "$plan_json" \
      || die "CONTRACT_0065_PREWRITE_RECOVERY_PLAN_REJECTED" 73
    contract_0065_release_id="$unfinished_release_id"
    contract_0065_backup_file="$unfinished_backup_file"
    contract_0065_expected_applied_count="65"
    contract_0065_expected_applied_journal_hash="$SITEOPS_ALIDNS_OAUTH_APPLIED_JOURNAL_HASH"
    contract_0065_prewrite_armed=1
    if restart_contract_0065_prewrite "host-recovery"; then
      die "CONTRACT_0065_PREWRITE_RECOVERED_NOT_RERUN" 75
    fi
    die "CONTRACT_0065_PREWRITE_RECOVERY_UNPROVEN" 75
  elif [[ $unfinished_status == "in_progress" && \
          $unfinished_message == "contract-0065-restore-started" ]]; then
    contract_0065_release_id="$unfinished_release_id"
    contract_0065_backup_file="$unfinished_backup_file"
    contract_0065_expected_applied_count="65"
    contract_0065_expected_applied_journal_hash="$SITEOPS_ALIDNS_OAUTH_APPLIED_JOURNAL_HASH"
    contract_0065_rollback_armed=1
    contract_0065_restore_in_progress=1
    quarantine_contract_0065_restore "host-recovery-interrupted" \
      || die "CONTRACT_0065_HOST_RESTORE_QUARANTINE_FAILED" 75
    die "CONTRACT_0065_HOST_RESTORE_INTERRUPTED_QUARANTINED" 75
  elif [[ $unfinished_status == "in_progress" && \
          $unfinished_message =~ ^contract-0065-migration-(started|complete)$ ]]; then
    contract_0065_release_id="$unfinished_release_id"
    contract_0065_backup_file="$unfinished_backup_file"
    contract_0065_expected_applied_count="65"
    contract_0065_expected_applied_journal_hash="$SITEOPS_ALIDNS_OAUTH_APPLIED_JOURNAL_HASH"
    contract_0065_rollback_armed=1
    contract_0065_facts_are_valid \
      || die "CONTRACT_0065_RECONCILIATION_FACTS_INVALID" 73
    if siteops_alidns_oauth_exact_state_matches "$plan_json" plan; then
      log "CONTRACT_0065_MIGRATION_RECONCILED_EXACT release=${unfinished_release_id}"
      backup_file="$unfinished_backup_file"
      database_changed=1
      reconciliation_postflight="$(run_release_db_json "$candidate_env" postflight --json)" \
        || die "CONTRACT_0065_RECONCILIATION_POSTFLIGHT_FAILED" 78
      siteops_alidns_oauth_exact_state_matches "$reconciliation_postflight" postflight \
        || die "CONTRACT_0065_RECONCILIATION_POSTFLIGHT_NOT_EXACT" 78
      journal_hash="$SITEOPS_ALIDNS_OAUTH_CONTRACT_JOURNAL_HASH"
    else
      restore_contract_0065_release "host-recovery-nonexact" \
        || die "CONTRACT_0065_HOST_RESTORE_UNPROVEN" 75
      die "CONTRACT_0065_HOST_RESTORE_COMPLETE_NOT_RERUN" 75
    fi
  elif [[ $unfinished_status == "in_progress" ]]; then
    [[ -n $unfinished_backup_file && -f $unfinished_backup_file ]] \
      || die "UNFINISHED_RELEASE_BACKUP_MISSING" 75
    if [[ $plan_status == "exact" && $plan_schema_status == "exact" ]]; then
      log "UNFINISHED_MIGRATION_RECONCILED_EXACT release=${unfinished_release_id}"
      backup_file="$unfinished_backup_file"
      database_changed=1
      reconciliation_postflight="$(run_release_db_json "$candidate_env" postflight --json)" || {
        restore_production_database "$unfinished_backup_file" \
          || die "UNFINISHED_RELEASE_DATABASE_RESTORE_FAILED"
        record_recovered_incident "$candidate_env" \
          "unfinished-postflight-failed-database-restored" \
          "UNFINISHED_RELEASE_APPLICATION_ROLLBACK_FAILED_STATE_PRESERVED" \
          "$unfinished_release_id" "$unfinished_backup_file"
        die "UNFINISHED_RELEASE_POSTFLIGHT_FAILED"
      }
      if ! jq -e '.status == "exact" and .schema.status == "exact"' \
        <<<"$reconciliation_postflight" >/dev/null; then
        restore_production_database "$unfinished_backup_file" \
          || die "UNFINISHED_RELEASE_DATABASE_RESTORE_FAILED"
        record_recovered_incident "$candidate_env" \
          "unfinished-postflight-not-exact-database-restored" \
          "UNFINISHED_RELEASE_APPLICATION_ROLLBACK_FAILED_STATE_PRESERVED" \
          "$unfinished_release_id" "$unfinished_backup_file"
        die "UNFINISHED_RELEASE_POSTFLIGHT_NOT_EXACT"
      fi
    else
      restore_production_database "$unfinished_backup_file" \
        || die "UNFINISHED_RELEASE_DATABASE_RESTORE_FAILED"
      record_recovered_incident "$candidate_env" \
        "unfinished-migration-restored-from-backup" \
        "UNFINISHED_RELEASE_APPLICATION_ROLLBACK_FAILED_STATE_PRESERVED" \
        "$unfinished_release_id" "$unfinished_backup_file"
      die "UNFINISHED_RELEASE_RESTORED_NOT_RERUN" 75
    fi
  fi

  case "$plan_status" in
    exact)
      if [[ $plan_schema_status != "exact" ]]; then
        record_failure "database-schema-${plan_schema_status}"
        rotate_service_images "$current_digest" "$previous_digest"
        die "DATABASE_SCHEMA_NOT_EXACT" 78
      fi
      log "DATABASE_PLAN_EXACT"
      ;;
    pending)
      if [[ $unfinished_status == "in_progress" ]]; then
        die "UNFINISHED_PENDING_SHOULD_HAVE_BEEN_RESTORED" 75
      fi
      initial_applied_fact="$(applied_fact_from_plan "$plan_json")" || {
        record_failure "database-applied-fact-invalid"
        rotate_service_images "$current_digest" "$previous_digest"
        die "DATABASE_APPLIED_FACT_INVALID" 78
      }
      read -r expected_applied_count expected_applied_journal_hash extra_applied_fact \
        <<<"$initial_applied_fact"
      [[ -z ${extra_applied_fact:-} && $expected_applied_count =~ ^[0-9]+$ && \
        $expected_applied_journal_hash =~ ^[a-f0-9]{64}$ ]] || {
        record_failure "database-applied-fact-invalid"
        rotate_service_images "$current_digest" "$previous_digest"
        die "DATABASE_APPLIED_FACT_INVALID" 78
      }
      migration_kind=""
      if jq -e '.allPendingExpand == true and (.pending | length > 0) and all(.pending[]; .classification == "expand")' \
        <<<"$plan_json" >/dev/null; then
        migration_kind="expand"
      elif (( siteops_alidns_oauth_contract == 1 && coupled_stack_mode == 0 )); then
        migration_kind="contract-0065"
      else
        record_failure "contract-or-unclassified-migration-blocked"
        rotate_service_images "$current_digest" "$previous_digest"
        die "CONTRACT_MIGRATION_REQUIRES_MAINTENANCE_WINDOW" 78
      fi
      if [[ $migration_kind == "contract-0065" ]]; then
        [[ $expected_applied_count == "65" && \
           $expected_applied_journal_hash == "$SITEOPS_ALIDNS_OAUTH_APPLIED_JOURNAL_HASH" ]] \
          || die "CONTRACT_0065_APPLIED_FACT_REJECTED" 78
        contract_0065_expected_applied_count="$expected_applied_count"
        contract_0065_expected_applied_journal_hash="$expected_applied_journal_hash"
      fi
      log "MIGRATION_APPROVED kind=${migration_kind}"
      release_id="${source_sha}-$(date -u +%Y%m%dT%H%M%SZ)"
      if [[ $migration_kind == "contract-0065" ]]; then
        contract_0065_release_id="$release_id"
        contract_0065_backup_file=""
        contract_0065_prewrite_armed=1
        trap '' INT TERM HUP
        if record_contract_0065_phase \
          "contract-0065-prewrite-stop-started" "$release_id"; then
          trap 'handle_controller_signal INT 130' INT
          trap 'handle_controller_signal TERM 143' TERM
          trap 'handle_controller_signal HUP 129' HUP
        else
          trap 'handle_controller_signal INT 130' INT
          trap 'handle_controller_signal TERM 143' TERM
          trap 'handle_controller_signal HUP 129' HUP
          die "CONTRACT_0065_PREWRITE_SENTINEL_FAILED" 73
        fi
      fi
      if [[ -n $current_digest ]]; then
        current_env="$(mktemp)"
        make_compose_env "$current_env" "${IMAGE_REPOSITORY}@${current_digest}"
        stop_application_runtime "$current_env"
        rm -f -- "$current_env"
      fi
      backup_file="${BACKUP_DIR:-/var/backups/frontmind-dashboard}/frontmind-dashboard-$(date -u +%Y%m%dT%H%M%SZ)-${source_sha:0:12}.sql.gz"
      if ! backup_database \
        "$backup_file" "$expected_applied_count" "$expected_applied_journal_hash"; then
        if (( coupled_stack_mode == 1 )); then
          die "DATABASE_BACKUP_FAILED" 75
        fi
        if [[ $migration_kind == "contract-0065" ]]; then
          die "CONTRACT_0065_DATABASE_BACKUP_FAILED" 78
        fi
        if restore_previous_application "$candidate_env"; then
          record_failure "database-backup-failed"
          rotate_service_images "$current_digest" "$previous_digest"
        else
          record_failure "database-backup-failed-rollback-failed"
        fi
        die "DATABASE_BACKUP_FAILED"
      fi
      if [[ $migration_kind == "contract-0065" ]]; then
        contract_0065_backup_file="$backup_file"
        record_contract_0065_phase \
          "contract-0065-prewrite-backup-complete" "$release_id" "$backup_file" \
          || die "CONTRACT_0065_PREWRITE_BACKUP_SENTINEL_FAILED" 73
        contract_0065_migration_container_absent \
          || die "CONTRACT_0065_MIGRATION_CONTAINER_NAME_OCCUPIED" 75
      fi
      update_coupled_stack_database_recovery "$backup_file" "$release_id" \
        || die "PRODUCTION_COUPLED_STACK_DATABASE_RECOVERY_CAPSULE_FAILED" 75
      if [[ $migration_kind == "contract-0065" ]]; then
        trap '' INT TERM HUP
        if record_contract_0065_phase \
          "contract-0065-migration-started" "$release_id" "$backup_file"; then
          contract_0065_prewrite_armed=0
          contract_0065_rollback_armed=1
          trap 'handle_controller_signal INT 130' INT
          trap 'handle_controller_signal TERM 143' TERM
          trap 'handle_controller_signal HUP 129' HUP
        else
          trap 'handle_controller_signal INT 130' INT
          trap 'handle_controller_signal TERM 143' TERM
          trap 'handle_controller_signal HUP 129' HUP
          die "CONTRACT_0065_MIGRATION_SENTINEL_FAILED" 73
        fi
      else
        record_in_progress "$release_id" "$backup_file"
      fi
      migration_arguments=(
        migrate
        --release-id "$release_id"
        --expected-applied-count "$expected_applied_count"
        --expected-applied-journal-hash "$expected_applied_journal_hash"
      )
      migration_arguments+=(--json)
      migration_status=0
      migration_reconciled=0
      if [[ $migration_kind == "contract-0065" ]]; then
        run_contract_0065_migration_json \
          "$candidate_env" "$release_id" "$expected_applied_count" \
          "$expected_applied_journal_hash" || migration_status=$?
        migration_json="$contract_0065_json_output"
      else
        migration_json="$(run_release_db_json "$candidate_env" "${migration_arguments[@]}")" \
          || migration_status=$?
      fi
      if (( migration_status != 0 )); then
        if jq -e \
          '.status == "error" and .error.code == "MIGRATION_APPLIED_FACT_CHANGED"' \
          <<<"$migration_json" >/dev/null 2>&1; then
          # release-db checks this fact while holding the advisory lock and
          # before invoking Drizzle. The ledger change therefore belongs to an
          # external actor, not this release. Never overwrite it with our old
          # backup and keep Dashboard writes stopped for incident review.
          if (( coupled_stack_mode == 1 )) && \
             ! mark_coupled_stack_external_fact_changed; then
            coupled_stack_restore_armed=0
            record_quarantine \
              "migration-applied-fact-changed-capsule-update-failed-dashboard-remains-stopped" \
              "$release_id" "$backup_file"
            die "MIGRATION_APPLIED_FACT_CHANGED_CAPSULE_UPDATE_FAILED" 75
          fi
          if [[ $migration_kind == "contract-0065" ]]; then
            contract_0065_rollback_armed=0
          fi
          record_quarantine \
            "migration-applied-fact-changed-before-ddl-dashboard-remains-stopped" \
            "$release_id" "$backup_file"
          die "MIGRATION_APPLIED_FACT_CHANGED_INCIDENT_QUARANTINED" 75
        fi
        log "MIGRATION_RESULT_UNKNOWN_RECONCILING"
        recovery_plan="$(run_release_db_json "$candidate_env" plan --json)" || \
          recovery_plan='{"status":"unknown"}'
        if [[ $migration_kind == "contract-0065" ]] \
          && siteops_alidns_oauth_exact_state_matches "$recovery_plan" plan; then
          migration_json="$(run_release_db_json "$candidate_env" postflight --json)" \
            || die "CONTRACT_0065_UNKNOWN_POSTFLIGHT_FAILED" 78
          siteops_alidns_oauth_exact_state_matches "$migration_json" postflight \
            || die "CONTRACT_0065_UNKNOWN_POSTFLIGHT_NOT_EXACT" 78
          migration_reconciled=1
          log "MIGRATION_RECONCILED_EXACT"
        elif jq -e '.status == "exact" and .schema.status == "exact"' \
          <<<"$recovery_plan" >/dev/null; then
          log "MIGRATION_RECONCILED_EXACT"
          migration_json="$recovery_plan"
        else
          if (( coupled_stack_mode == 1 )); then
            die "DATABASE_MIGRATION_UNKNOWN_NOT_RERUN" 75
          fi
          if [[ $migration_kind == "contract-0065" ]]; then
            die "CONTRACT_0065_MIGRATION_UNKNOWN_RESTORE_REQUIRED" 78
          fi
          restore_production_database "$backup_file" \
            || die "DATABASE_RESTORE_FAILED_AFTER_MIGRATION_ERROR"
          record_recovered_incident "$candidate_env" \
            "migration-result-unknown-database-restored" \
            "APPLICATION_ROLLBACK_FAILED_AFTER_MIGRATION_ERROR_STATE_PRESERVED" \
            "$release_id" "$backup_file"
          die "DATABASE_MIGRATION_UNKNOWN_NOT_RERUN"
        fi
      fi
      migration_exact=0
      if [[ $migration_kind == "contract-0065" ]]; then
        if (( migration_reconciled == 1 )); then
          siteops_alidns_oauth_exact_state_matches "$migration_json" postflight \
            && migration_exact=1
        else
          siteops_alidns_oauth_migration_result_matches \
            "$migration_json" "$release_id" \
            && migration_exact=1
        fi
      elif jq -e '.status == "exact" and .schema.status == "exact"' \
        <<<"$migration_json" >/dev/null; then
        migration_exact=1
      fi
      if (( migration_exact == 0 )); then
        if (( coupled_stack_mode == 1 )); then
          die "DATABASE_MIGRATION_RESULT_NOT_EXACT" 75
        fi
        if [[ $migration_kind == "contract-0065" ]]; then
          die "CONTRACT_0065_MIGRATION_RESULT_NOT_EXACT" 78
        fi
        restore_production_database "$backup_file" \
          || die "DATABASE_RESTORE_FAILED_AFTER_MIGRATION_MISMATCH"
        record_recovered_incident "$candidate_env" \
          "migration-result-not-exact-database-restored" \
          "APPLICATION_ROLLBACK_FAILED_AFTER_MIGRATION_MISMATCH_STATE_PRESERVED" \
          "$release_id" "$backup_file"
        die "DATABASE_MIGRATION_RESULT_NOT_EXACT"
      fi
      journal_hash="$(jq -r '.journalHash // .expected.journalHash // ""' <<<"$migration_json")"
      if [[ $migration_kind == "contract-0065" ]]; then
        [[ $journal_hash == "$SITEOPS_ALIDNS_OAUTH_CONTRACT_JOURNAL_HASH" ]] \
          || die "CONTRACT_0065_MIGRATION_JOURNAL_REJECTED" 78
        trap '' INT TERM HUP
        if write_state \
          "$current_digest" "$previous_digest" "$current_source_sha" \
          "$journal_hash" "$current_deployed_at" \
          "in_progress" "contract-0065-migration-complete" "$digest" \
          "$release_id" "$backup_file"; then
          trap 'handle_controller_signal INT 130' INT
          trap 'handle_controller_signal TERM 143' TERM
          trap 'handle_controller_signal HUP 129' HUP
        else
          trap 'handle_controller_signal INT 130' INT
          trap 'handle_controller_signal TERM 143' TERM
          trap 'handle_controller_signal HUP 129' HUP
          die "CONTRACT_0065_COMPLETE_SENTINEL_FAILED" 73
        fi
      fi
      database_changed=1
      ;;
    ahead)
      record_failure "database-journal-ahead"
      rotate_service_images "$current_digest" "$previous_digest"
      die "DATABASE_JOURNAL_AHEAD" 78
      ;;
    diverged)
      record_failure "database-journal-diverged"
      rotate_service_images "$current_digest" "$previous_digest"
      die "DATABASE_JOURNAL_DIVERGED" 78
      ;;
    *)
      record_failure "database-plan-invalid-status"
      rotate_service_images "$current_digest" "$previous_digest"
      die "DATABASE_PLAN_STATUS_INVALID"
      ;;
  esac
fi

if [[ $current_digest == "$digest" && $unfinished_status != "in_progress" ]]; then
  idempotent_deadline=$((SECONDS + 30))
  if wait_until_ready "$source_sha" "$digest" "$idempotent_deadline"; then
    write_state \
      "$current_digest" "$previous_digest" "$current_source_sha" "$journal_hash" \
      "$current_deployed_at" "success" "already-current" "$digest"
    rotate_service_images "$current_digest" "$previous_digest"
    if (( coupled_stack_mode == 1 )); then
      deploy_coupled_website_and_finalize \
        || die "PRODUCTION_COUPLED_STACK_WEBSITE_FAILED" 75
    else
      log "DEPLOY_ALREADY_CURRENT service=${service} digest=${digest}"
    fi
    exit 0
  fi
  record_failure "current-digest-unready-no-state-rotation"
  die "CURRENT_DIGEST_UNREADY_REQUIRES_EXPLICIT_ROLLBACK" 75
fi

log "APPLICATION_ROLLOUT_START service=${service}"
rollout_deadline=$((SECONDS + DEPLOY_TIMEOUT_SECONDS))
candidate_ready_deadline=$((SECONDS + CANDIDATE_READY_BUDGET_SECONDS))
if ! roll_out "$candidate_env" "$source_sha" "$digest" "$candidate_ready_deadline"; then
  log "APPLICATION_ROLLOUT_FAILED"
  stop_application_runtime "$candidate_env" >/dev/null 2>&1 || true
  if (( coupled_stack_mode == 1 )); then
    die "APPLICATION_READINESS_TIMEOUT" 75
  fi
  if (( database_changed == 1 )); then
    if (( contract_0065_rollback_armed == 1 )); then
      die "CONTRACT_0065_APPLICATION_READINESS_RESTORE_REQUIRED" 75
    fi
    restore_production_database "$backup_file" || die "DATABASE_RESTORE_FAILED_AFTER_APPLICATION_ERROR"
    record_recovered_failure "$candidate_env" \
      "candidate-unready-previous-restored" \
      "APPLICATION_ROLLBACK_FAILED_AFTER_CANDIDATE_ERROR_STATE_PRESERVED"
    die "APPLICATION_READINESS_TIMEOUT"
  fi
  if restore_previous_application "$candidate_env" "$rollout_deadline"; then
    record_failure "candidate-unready-previous-restored"
    rotate_service_images "$current_digest" "$previous_digest"
  else
    record_failure "candidate-unready-rollback-failed"
  fi
  die "APPLICATION_READINESS_TIMEOUT"
fi

write_active_image_env "$image"
deployed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
next_previous_digest="$current_digest"
if [[ $current_digest == "$digest" ]]; then
  next_previous_digest="$previous_digest"
fi
write_state \
  "$digest" "$next_previous_digest" "$source_sha" "$journal_hash" \
  "$deployed_at" "success" "ready" "$digest"
if (( contract_0065_rollback_armed == 1 )); then
  contract_0065_terminal_state_committed \
    || die "CONTRACT_0065_TERMINAL_STATE_COMMIT_UNPROVEN" 73
  contract_0065_rollback_armed=0
fi

if (( database_changed == 1 )); then
  rotate_backups
fi
rotate_service_images "$digest" "$current_digest"
if (( coupled_stack_mode == 1 )); then
  deploy_coupled_website_and_finalize \
    || die "PRODUCTION_COUPLED_STACK_WEBSITE_FAILED" 75
else
  log "DEPLOY_SUCCESS service=${service} digest=${digest} source=${source_sha}"
fi
