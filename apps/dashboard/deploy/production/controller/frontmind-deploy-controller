write_dashboard_active_env_exact() {
  local selected_image="$1" selected_sha="$2" temporary
  temporary="$(mktemp "${IMAGE_ENV_FILE}.tmp.XXXXXX")" || return 1
  if ! cp -- "$COMPOSE_ENV_FILE" "$temporary" \
    || ! printf '%s=%s\n' "$IMAGE_ENV_KEY" "$selected_image" >>"$temporary" \
    || ! printf 'FRONTMIND_IMAGE_DIGEST=%s\n' "${selected_image##*@}" >>"$temporary" \
    || ! printf 'FRONTMIND_SOURCE_SHA=%s\n' "$selected_sha" >>"$temporary" \
    || ! chmod 0600 "$temporary" \
    || ! mv -f -- "$temporary" "$IMAGE_ENV_FILE"; then
    rm -f -- "$temporary" || true
    return 1
  fi
}

render_coupled_website_runtime_v2() {
  local source="$1" target="$2" current count
  config_is_root_only "$source" || return 1
  count="$(grep -Ec '^FRONTMIND_PRESALES_AGENT_URL=' "$source" || true)"
  [[ $count == "1" ]] || return 1
  current="$(sed -n 's/^FRONTMIND_PRESALES_AGENT_URL=//p' "$source")"
  [[ $current == "http://frontmind-dashboard:3001/api/internal/presales" || \
     $current == "http://frontmind-dashboard:3001/api/internal/presales/v2" ]] \
    || return 1
  awk '
    /^FRONTMIND_PRESALES_AGENT_URL=/ {
      print "FRONTMIND_PRESALES_AGENT_URL=http://frontmind-dashboard:3001/api/internal/presales/v2"
      next
    }
    { print }
  ' "$source" >"$target" || return 1
  chmod 0600 "$target" || return 1
}

render_coupled_dashboard_runtime_v5() {
  local source="$1" target="$2" current count
  config_is_root_only "$source" || return 1
  count="$(grep -Ec '^FRONTMIND_KB_SKILL_PATH=' "$source" || true)"
  [[ $count == "1" ]] || return 1
  current="$(sed -n 's/^FRONTMIND_KB_SKILL_PATH=//p' "$source")"
  [[ $current == "/app/dist/private-workflows/socratic-kb-builder.skill" || \
     $current == "/app/dist/private-workflows/socratic-kb-builder-v4.skill" || \
     $current == "/app/dist/private-workflows/socratic-kb-builder-v5.skill" ]] \
    || return 1
  awk '
    /^FRONTMIND_KB_V4_ROLLOUT_PERCENT=/ { next }
    /^FRONTMIND_KB_V4_ALLOW_USER_IDS=/ { next }
    /^FRONTMIND_KB_MANUS_V2_WRITER=/ { next }
    /^FRONTMIND_KB_MANUS_V2_ACTIVE_MIGRATION=/ { next }
    /^FRONTMIND_KB_SKILL_PATH=/ {
      print "FRONTMIND_KB_SKILL_PATH=/app/dist/private-workflows/socratic-kb-builder-v5.skill"
      next
    }
    { print }
  ' "$source" >"$target" || return 1
  chmod 0600 "$target" || return 1
}

write_coupled_stack_capsule() {
  local website_current="$1" website_previous="$2" website_source="$3"
  local website_deployed_at="$4" website_runtime_sha="$5"
  local dashboard_runtime_sha="$6" temporary
  mkdir -p -m 0700 "$(dirname "$COUPLED_STACK_CAPSULE_FILE")" || return 1
  temporary="$(mktemp "${COUPLED_STACK_CAPSULE_FILE}.tmp.XXXXXX")" || return 1
  if ! jq -n \
    --arg oldDashboardDigest "$current_digest" \
    --arg oldDashboardPreviousDigest "$previous_digest" \
    --arg oldDashboardSourceSha "$current_source_sha" \
    --arg oldDashboardJournalHash "$current_journal_hash" \
    --arg oldDashboardDeployedAt "$current_deployed_at" \
    --arg dashboardRuntimeSha256 "$dashboard_runtime_sha" \
    --arg newDashboardImage "$image" \
    --arg newDashboardSourceSha "$source_sha" \
    --arg oldWebsiteDigest "$website_current" \
    --arg oldWebsitePreviousDigest "$website_previous" \
    --arg oldWebsiteSourceSha "$website_source" \
    --arg oldWebsiteDeployedAt "$website_deployed_at" \
    --arg newWebsiteImage "$coupled_website_image" \
    --arg newWebsiteSourceSha "$coupled_website_source_sha" \
    --arg websiteRuntimeSha256 "$website_runtime_sha" \
    --arg createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
      {
        schemaVersion: 1,
        state: "provider-pending",
        createdAt: $createdAt,
        dashboard: {
          oldDigest: $oldDashboardDigest,
          oldPreviousDigest: $oldDashboardPreviousDigest,
          oldSourceSha: $oldDashboardSourceSha,
          oldJournalHash: $oldDashboardJournalHash,
          oldDeployedAt: $oldDashboardDeployedAt,
          newImage: $newDashboardImage,
          newSourceSha: $newDashboardSourceSha,
          runtimeRollbackSha256: $dashboardRuntimeSha256,
          databaseRestoreRequired: false,
          backupFile: "",
          releaseId: "",
          quarantineReason: ""
        },
        website: {
          oldDigest: $oldWebsiteDigest,
          oldPreviousDigest: $oldWebsitePreviousDigest,
          oldSourceSha: $oldWebsiteSourceSha,
          oldDeployedAt: $oldWebsiteDeployedAt,
          newImage: $newWebsiteImage,
          newSourceSha: $newWebsiteSourceSha,
          runtimeRollbackSha256: $websiteRuntimeSha256
        }
      }
    ' >"$temporary" \
    || ! chmod 0600 "$temporary" \
    || ! mv -f -- "$temporary" "$COUPLED_STACK_CAPSULE_FILE"; then
    rm -f -- "$temporary" || true
    return 1
  fi
}

update_coupled_stack_database_recovery() {
  local selected_backup="$1" selected_release_id="$2" temporary
  (( coupled_stack_mode == 1 )) || return 0
  config_is_root_only "$COUPLED_STACK_CAPSULE_FILE" || return 1
  [[ -f $selected_backup && ! -L $selected_backup ]] || return 1
  [[ $selected_release_id =~ ^[a-f0-9]{40}-[0-9]{8}T[0-9]{6}Z$ ]] || return 1
  temporary="$(mktemp "${COUPLED_STACK_CAPSULE_FILE}.tmp.XXXXXX")" || return 1
  if ! jq --arg backupFile "$selected_backup" \
      --arg releaseId "$selected_release_id" \
      '.dashboard.databaseRestoreRequired = true |
       .dashboard.backupFile = $backupFile |
       .dashboard.releaseId = $releaseId |
       .state = "migration-pending"' \
      "$COUPLED_STACK_CAPSULE_FILE" >"$temporary" \
    || ! chmod 0600 "$temporary" \
    || ! mv -f -- "$temporary" "$COUPLED_STACK_CAPSULE_FILE"; then
    rm -f -- "$temporary" || true
    return 1
  fi
}

mark_coupled_stack_external_fact_changed() {
  local temporary
  (( coupled_stack_mode == 1 )) || return 0
  config_is_root_only "$COUPLED_STACK_CAPSULE_FILE" || return 1
  temporary="$(mktemp "${COUPLED_STACK_CAPSULE_FILE}.tmp.XXXXXX")" || return 1
  if ! jq '
      .dashboard.databaseRestoreRequired = false |
      .dashboard.quarantineReason =
        "migration-applied-fact-changed-before-ddl-dashboard-remains-stopped" |
      .state = "external-migration-fact-changed"
    ' "$COUPLED_STACK_CAPSULE_FILE" >"$temporary" \
    || ! chmod 0600 "$temporary" \
    || ! mv -f -- "$temporary" "$COUPLED_STACK_CAPSULE_FILE"; then
    rm -f -- "$temporary" || true
    return 1
  fi
}

normalize_coupled_runtime_rollback() {
  local rollback="$1" retiring="$2" expected_sha="$3"
  if [[ ! -e $rollback && ! -L $rollback && \
        ( -e $retiring || -L $retiring ) ]]; then
    config_is_root_only "$retiring" || return 1
    [[ $(sha256sum "$retiring" | awk '{print $1}') == "$expected_sha" ]] \
      || return 1
    mv -f -- "$retiring" "$rollback" || return 1
  fi
  config_is_root_only "$rollback" || return 1
  [[ $(sha256sum "$rollback" | awk '{print $1}') == "$expected_sha" ]] \
    || return 1
  [[ ! -e $retiring && ! -L $retiring ]]
}

cleanup_committed_coupled_retiring_residue() {
  local retiring
  [[ ! -e $COUPLED_STACK_CAPSULE_FILE && ! -L $COUPLED_STACK_CAPSULE_FILE ]] \
    || return 0
  for retiring in \
    "$COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV" \
    "$COUPLED_WEBSITE_RUNTIME_RETIRING_ENV"; do
    if [[ -e $retiring || -L $retiring ]]; then
      config_is_root_only "$retiring" || return 1
      rm -f -- "$retiring" || return 1
    fi
  done
}

commit_coupled_stack_capsule_cleanup() {
  local rollback_status=0
  config_is_root_only "$COUPLED_STACK_CAPSULE_FILE" || return 1
  config_is_root_only "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" || return 1
  config_is_root_only "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" || return 1
  [[ ! -e $COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV && \
     ! -L $COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV && \
     ! -e $COUPLED_WEBSITE_RUNTIME_RETIRING_ENV && \
     ! -L $COUPLED_WEBSITE_RUNTIME_RETIRING_ENV ]] || return 1
  mv -f -- \
    "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" \
    "$COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV" || return 1
  if ! mv -f -- \
      "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" \
      "$COUPLED_WEBSITE_RUNTIME_RETIRING_ENV"; then
    mv -f -- \
      "$COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV" \
      "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" || true
    return 1
  fi
  if ! rm -f -- "$COUPLED_STACK_CAPSULE_FILE"; then
    mv -f -- \
      "$COUPLED_WEBSITE_RUNTIME_RETIRING_ENV" \
      "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" || rollback_status=1
    mv -f -- \
      "$COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV" \
      "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" || rollback_status=1
    (( rollback_status == 0 )) || return 1
    return 1
  fi
  rm -f -- \
    "$COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV" \
    "$COUPLED_WEBSITE_RUNTIME_RETIRING_ENV" \
    || log "PRODUCTION_COUPLED_STACK_RETIRING_ENV_RESIDUE_WARNING"
  return 0
}

prepare_coupled_stack() {
  local website_current website_previous website_source website_deployed_at
  local old_website_image active_image active_source
  local website_container_id
  local website_runtime_sha dashboard_runtime_sha
  local staged_website_runtime staged_dashboard_runtime
  (( coupled_stack_mode == 1 )) || return 0
  cleanup_committed_coupled_retiring_residue || return 1
  [[ -f $COUPLED_WEBSITE_COMPOSE_FILE && -d $COUPLED_WEBSITE_COMPOSE_DIR ]] || return 1
  config_is_root_only "$COUPLED_WEBSITE_STATE_FILE" || return 1
  config_is_root_only "$COUPLED_DASHBOARD_RUNTIME_ENV_FILE" || return 1
  config_is_root_only "$COUPLED_WEBSITE_RUNTIME_ENV_FILE" || return 1
  [[ ! -e $COUPLED_STACK_CAPSULE_FILE && ! -L $COUPLED_STACK_CAPSULE_FILE && \
     ! -e $COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV && ! -L $COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV && \
     ! -e $COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV && ! -L $COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV && \
     ! -e $COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV && ! -L $COUPLED_DASHBOARD_RUNTIME_RETIRING_ENV && \
     ! -e $COUPLED_WEBSITE_RUNTIME_RETIRING_ENV && ! -L $COUPLED_WEBSITE_RUNTIME_RETIRING_ENV ]] \
    || return 1
  website_current="$(jq -er '.currentDigest | select(test("^sha256:[a-f0-9]{64}$"))' \
    "$COUPLED_WEBSITE_STATE_FILE")" || return 1
  website_previous="$(jq -er '.previousDigest | select(type == "string")' \
    "$COUPLED_WEBSITE_STATE_FILE")" || return 1
  website_source="$(jq -er '.sourceSha | select(test("^[a-f0-9]{40}$"))' \
    "$COUPLED_WEBSITE_STATE_FILE")" || return 1
  website_deployed_at="$(jq -er '.deployedAt | select(type == "string" and length > 0)' \
    "$COUPLED_WEBSITE_STATE_FILE")" || return 1
  old_website_image="${COUPLED_WEBSITE_IMAGE_REPOSITORY}@${website_current}"
  coupled_website_env="$(mktemp)" || return 1
  make_coupled_website_env "$coupled_website_env" "$old_website_image" || return 1
  website_container_id="$(resolve_coupled_website_container_id "$coupled_website_env")" \
    || return 1
  active_image="$(docker inspect --format '{{.Config.Image}}' "$website_container_id" 2>/dev/null)" \
    || return 1
  active_source="$(docker inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' \
    "$website_container_id" 2>/dev/null)" || return 1
  [[ $active_image == "$old_website_image" && $active_source == "$website_source" && \
     $(docker inspect --format '{{.State.Running}}' "$website_container_id" 2>/dev/null) == "true" ]] \
    || return 1
  if ! atomic_copy \
      "$COUPLED_DASHBOARD_RUNTIME_ENV_FILE" "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" \
    || ! atomic_copy \
      "$COUPLED_WEBSITE_RUNTIME_ENV_FILE" "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV"; then
    rm -f -- \
      "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" \
      "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" || true
    return 1
  fi
  if ! dashboard_runtime_sha="$(sha256sum \
      "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" | awk '{print $1}')" \
    || ! website_runtime_sha="$(sha256sum \
      "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" | awk '{print $1}')"; then
    rm -f -- \
      "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" \
      "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" || true
    return 1
  fi
  if [[ ! $dashboard_runtime_sha =~ ^[a-f0-9]{64}$ || \
        ! $website_runtime_sha =~ ^[a-f0-9]{64}$ ]]; then
    rm -f -- \
      "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" \
      "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" || true
    return 1
  fi
  if ! write_coupled_stack_capsule \
      "$website_current" "$website_previous" "$website_source" \
      "$website_deployed_at" "$website_runtime_sha" "$dashboard_runtime_sha"; then
    rm -f -- \
      "$COUPLED_DASHBOARD_RUNTIME_ROLLBACK_ENV" \
      "$COUPLED_WEBSITE_RUNTIME_ROLLBACK_ENV" || true
    return 1
  fi
  coupled_stack_restore_armed=1
  coupled_website_compose "$coupled_website_env" stop website >/dev/null || return 1
  [[ $(docker inspect --format '{{.State.Running}}' "$website_container_id" 2>/dev/null) == "false" ]] \
    || return 1
  staged_dashboard_runtime="$(mktemp "${COUPLED_DASHBOARD_RUNTIME_ENV_FILE}.staged.XXXXXX")" \
    || return 1
  if ! render_coupled_dashboard_runtime_v5 \
      "$COUPLED_DASHBOARD_RUNTIME_ENV_FILE" "$staged_dashboard_runtime" \
    || ! atomic_copy \
      "$staged_dashboard_runtime" "$COUPLED_DASHBOARD_RUNTIME_ENV_FILE"; then
    rm -f -- "$staged_dashboard_runtime" || true
    return 1
  fi
  rm -f -- "$staged_dashboard_runtime" || return 1
  staged_website_runtime="$(mktemp "${COUPLED_WEBSITE_RUNTIME_ENV_FILE}.staged.XXXXXX")" \
    || return 1
  if ! render_coupled_website_runtime_v2 \
      "$COUPLED_WEBSITE_RUNTIME_ENV_FILE" "$staged_website_runtime" \
    || ! atomic_copy \
      "$staged_website_runtime" "$COUPLED_WEBSITE_RUNTIME_ENV_FILE"; then
    rm -f -- "$staged_website_runtime" || true
    return 1
  fi
  rm -f -- "$staged_website_runtime" || return 1
  log "PRODUCTION_COUPLED_STACK_WEBSITE_STOPPED source=${website_source} digest=${website_current}"
}

