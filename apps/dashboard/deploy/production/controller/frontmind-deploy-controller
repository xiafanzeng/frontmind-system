coupled_website_ready_matches() {
  local payload="$1" expected_sha="$2" expected_digest="$3"
  jq -e --arg sha "$expected_sha" --arg digest "$expected_digest" '
    .status == "ok" and
    .channel == "production" and
    .releaseChannel == "production" and
    .paymentMode == "zpay" and
    .buildSha == $sha and
    .imageDigest == $digest and
    .dependencies.status == "ok" and
    .dependencies.agent.credentialConfigured == true and
    .dependencies.agent.monitorCredentialConfigured == true and
    .dependencies.agent.monitorCredentialAuthenticated == true and
    .dependencies.agent.publicUrlConfigured == true
  ' <<<"$payload" >/dev/null
}

wait_coupled_website_ready() {
  local expected_sha="$1" expected_digest="$2" deadline="$3"
  local local_payload public_payload
  while (( SECONDS < deadline )); do
    local_payload="$(curl --fail --silent --show-error --max-time 4 \
      "$COUPLED_WEBSITE_LOCAL_READY_URL" 2>/dev/null || true)"
    if coupled_website_ready_matches \
      "$local_payload" "$expected_sha" "$expected_digest" 2>/dev/null; then
      public_payload="$(curl --fail --silent --show-error --max-time 6 \
        "$COUPLED_WEBSITE_PUBLIC_READY_URL" 2>/dev/null || true)"
      if coupled_website_ready_matches \
        "$public_payload" "$expected_sha" "$expected_digest" 2>/dev/null; then
        return 0
      fi
    fi
    sleep 2
  done
  return 1
}

