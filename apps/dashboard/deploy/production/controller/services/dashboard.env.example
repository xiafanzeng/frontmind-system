# Root-owned controller policy. Copy to
# /etc/frontmind-deploy/services/dashboard.env, replace placeholders, chmod 0600.
IMAGE_REPOSITORY=ghcr.io/xiafanzeng/frontmind-dashboard
COSIGN_IDENTITY=https://github.com/xiafanzeng/frontmind-dashboard/.github/workflows/dashboard-ci.yml@refs/heads/main
COSIGN_ISSUER=https://token.actions.githubusercontent.com

COMPOSE_DIR=/opt/frontmind-deploy/dashboard
COMPOSE_FILE=/opt/frontmind-deploy/dashboard/compose.yaml
COMPOSE_ENV_FILE=/etc/frontmind-deploy/dashboard-compose.env
IMAGE_ENV_FILE=/opt/frontmind-deploy/dashboard/.env
COMPOSE_SERVICE=dashboard
IMAGE_ENV_KEY=FRONTMIND_DASHBOARD_IMAGE

LOCAL_READY_URL=http://127.0.0.1:3001/readyz
PUBLIC_READY_URL=https://dashboard.frontmind.net/readyz
READY_SHA_SHAPE=dashboard

STATE_DIR=/var/lib/frontmind-deploy/dashboard
BACKUP_DIR=/var/backups/frontmind-dashboard
BACKUP_DATABASE=frontmind_dashboard
BACKUP_MYSQL_CNF=/etc/frontmind-deploy/dashboard-backup.cnf
RESTORE_MYSQL_CNF=/etc/frontmind-deploy/dashboard-restore.cnf
