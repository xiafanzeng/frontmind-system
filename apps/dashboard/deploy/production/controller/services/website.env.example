# Root-owned controller policy. Website has no release-db service and this
# command never reads, backs up or mutates MySQL.
IMAGE_REPOSITORY=ghcr.io/xiafanzeng/frontmind-website
COSIGN_IDENTITY=https://github.com/xiafanzeng/frontmind-website/.github/workflows/ci-release.yml@refs/heads/main
COSIGN_ISSUER=https://token.actions.githubusercontent.com

COMPOSE_DIR=/opt/frontmind-deploy/website
COMPOSE_FILE=/opt/frontmind-deploy/website/compose.yaml
COMPOSE_ENV_FILE=/etc/frontmind-deploy/website-compose.env
IMAGE_ENV_FILE=/opt/frontmind-deploy/website/.env
COMPOSE_SERVICE=website
IMAGE_ENV_KEY=FRONTMIND_WEBSITE_IMAGE

LOCAL_READY_URL=http://127.0.0.1:8888/readyz
PUBLIC_READY_URL=https://www.frontmind.net/readyz
READY_SHA_SHAPE=website

STATE_DIR=/var/lib/frontmind-deploy/website
