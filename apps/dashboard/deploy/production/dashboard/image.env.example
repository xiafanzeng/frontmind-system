# Managed atomically by frontmind-deploy-controller after signature checking.
# Do not use a tag here.
FRONTMIND_DASHBOARD_IMAGE=ghcr.io/xiafanzeng/frontmind-dashboard@sha256:replace-with-64-hex-digest
FRONTMIND_IMAGE_DIGEST=sha256:replace-with-64-hex-digest
FRONTMIND_SOURCE_SHA=replace-with-40-hex-source-sha

# Non-secret host/Compose topology.
FRONTMIND_DASHBOARD_ENV_FILE=/etc/frontmind/dashboard.env
FRONTMIND_DASHBOARD_READINESS_ENV_FILE=/etc/frontmind/dashboard-readiness.env
FRONTMIND_DASHBOARD_MIGRATOR_ENV_FILE=/etc/frontmind/dashboard-migrator.env
FRONTMIND_DASHBOARD_HOST_PORT=3001
FRONTMIND_PREPARED_FILE_DIR_HOST=/var/lib/frontmind/prepared-files
FRONTMIND_DASHBOARD_ASSET_DIR_HOST=/var/lib/frontmind/dashboard-assets
FRONTMIND_APPLICATION_NETWORK=frontmind-applications
FRONTMIND_DATABASE_NETWORK=1panel-network
