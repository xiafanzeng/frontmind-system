# This account is injected only into the one-shot release-db container. It may
# apply DDL to frontmind_dashboard; the long-running application account must
# not have that permission.
NODE_ENV=production
MIGRATION_DATABASE_URL=mysql://frontmind_migrator:replace-with-url-encoded-password@mysql:3306/frontmind_dashboard
FRONTMIND_MIGRATIONS_DIR=/app/dist/drizzle
FRONTMIND_MIGRATION_MANIFEST_PATH=/app/dist/migration-manifest.json
