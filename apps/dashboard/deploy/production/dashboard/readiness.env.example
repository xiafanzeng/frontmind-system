# Dedicated read-only account for release-db plan/postflight. It needs SELECT
# on __drizzle_migrations plus information_schema visibility for the complete
# schema contract, but no DDL/DML on application tables.
NODE_ENV=production
DATABASE_URL=mysql://frontmind_readiness:replace-with-url-encoded-password@mysql:3306/frontmind_dashboard
FRONTMIND_MIGRATIONS_DIR=/app/dist/drizzle
FRONTMIND_MIGRATION_MANIFEST_PATH=/app/dist/migration-manifest.json
