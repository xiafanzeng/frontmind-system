NODE_ENV=production
PORT=3001
DATABASE_URL=mysql://frontmind_dashboard:replace-with-url-encoded-password@mysql:3306/frontmind_dashboard

FRONTMIND_CREDENTIAL_ENCRYPTION_KEY=base64:replace-with-32-random-bytes-in-base64
FRONTMIND_PRESALES_SERVICE_TOKEN=replace-with-independent-random-secret
FRONTMIND_PROVISIONING_SERVICE_TOKEN=replace-with-independent-random-secret
FRONTMIND_DASHBOARD_IMPORT_PREFLIGHT_SECRET=replace-with-independent-random-secret
FRONTMIND_MONITOR_API_KEY=replace-with-dedicated-monitor-key
# Optional dedicated value shared by every Dashboard replica when signing
# short-lived owned/prepared file download URLs. Use at least 32 random chars.
# Resolution order is this value, JWT_SECRET, then a domain-separated HKDF key
# derived from FRONTMIND_CREDENTIAL_ENCRYPTION_KEY. A dedicated value remains
# preferred so download-token rotation is independent of other credentials.
# FRONTMIND_DOWNLOAD_TOKEN_SECRET=

FRONTMIND_PUBLIC_URL=https://dashboard.frontmind.net
FRONTMIND_WEBSITE_URL=https://www.frontmind.net
FRONTMIND_DASHBOARD_IMPORT_PREFLIGHT_TTL_SECONDS=300
FRONTMIND_PREPARED_FILE_DIR=/var/lib/frontmind/prepared-files
FRONTMIND_PREPARED_FILE_TTL_MS=2592000000
FRONTMIND_DASHBOARD_ASSET_DIR=/var/lib/frontmind/dashboard-assets
FRONTMIND_PDF_WORKERS=1
FRONTMIND_CONVERSATION_RETENTION_DAYS=30
FRONTMIND_SERVICE_ENTITLEMENT_ENFORCEMENT=auto
FRONTMIND_KB_SKILL_PATH=/app/dist/private-workflows/socratic-kb-builder-v5.skill
FRONTMIND_BRAND_QUESTION_SKILL_PATH=/app/dist/private-workflows/brand-question-portfolio.skill
FRONTMIND_RESPONSE_LOGIC_SKILL_PATH=/app/dist/private-workflows/response-logic-builder.skill

# SiteOps is enabled by default unless explicitly set to 0. ESA publication
# uses the FrontMind-managed account through the standard Alibaba Cloud
# credential chain. Domain and AliDNS operations assume a customer-owned RAM
# Role and never require a customer permanent access key.
FRONTMIND_SITEOPS_ENABLED=1
FRONTMIND_ESA_ENABLED=1
FRONTMIND_ESA_INSTANCE_ID=replace-with-managed-esa-plan-instance
FRONTMIND_ALIYUN_DOMAIN_ENABLED=0
FRONTMIND_ALIYUN_ROLE_PRINCIPAL_ARN=acs:ram::replace-with-frontmind-account-id:role/frontmind-siteops-assumer
# Supply ALIBABA_CLOUD_ACCESS_KEY_ID + ALIBABA_CLOUD_ACCESS_KEY_SECRET and an
# optional ALIBABA_CLOUD_SECURITY_TOKEN through deployment secrets, or use
# OIDC, an ECS RAM Role, or Credentials URI. Never put credentials here.
