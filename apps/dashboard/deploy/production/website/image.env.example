# Managed atomically by frontmind-deploy-controller after signature checking.
FRONTMIND_WEBSITE_IMAGE=ghcr.io/xiafanzeng/frontmind-website@sha256:replace-with-64-hex-digest
FRONTMIND_IMAGE_DIGEST=sha256:replace-with-64-hex-digest
FRONTMIND_SOURCE_SHA=replace-with-40-hex-source-sha

FRONTMIND_WEBSITE_ENV_FILE=/etc/frontmind/website.env
FRONTMIND_WEBSITE_HOST_PORT=8888
FRONTMIND_WEBSITE_DATA_DIR_HOST=/var/lib/frontmind-website
FRONTMIND_APPLICATION_NETWORK=frontmind-applications
