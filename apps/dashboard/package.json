{
  "name": "frontmind-client",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "node scripts/build-production-release.mjs",
    "build:release": "node scripts/build-production-release.mjs",
    "audit:production": "node scripts/audit-production-bundle.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "check:governance": "node scripts/check-source-governance.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:release:repository": "node scripts/test-production-release-flow.mjs",
    "test:registry-retention": "node --test scripts/retention-tests/*.node-test.mjs",
    "test:kb:mysql-acceptance": "FRONTMIND_KB_MYSQL_ACCEPTANCE_REQUIRED=1 vitest run scripts/knowledge-base-mysql-acceptance.test.ts",
    "test:kb:mysql-e2e-acceptance": "FRONTMIND_KB_MYSQL_ACCEPTANCE_REQUIRED=1 vitest run scripts/knowledge-base-mysql-e2e-acceptance.test.ts",
    "test:release:mysql-acceptance": "FRONTMIND_RELEASE_MYSQL_ACCEPTANCE_REQUIRED=1 vitest run scripts/release-db-additive-mysql-acceptance.test.ts",
    "audit:kb:rollout": "tsx scripts/audit-knowledge-base-rollout.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "pnpm db:generate && pnpm db:migrate",
    "db:preflight-project-teams": "tsx scripts/preflight-project-team-migration.ts",
    "db:preflight-three-engineer-roles": "tsx scripts/preflight-three-engineer-roles.ts",
    "db:backfill-website-style-workflows": "tsx scripts/backfill-website-style-workflows.ts",
    "db:backfill-knowledge-base-v2": "tsx scripts/backfill-knowledge-base-state-machine.ts",
    "db:purge-icp-materials": "tsx scripts/purge-icp-materials.ts",
    "db:cleanup-expired": "tsx scripts/cleanup-expired-conversations.ts",
    "db:cleanup-expired-files": "tsx scripts/cleanup-expired-file-content.ts",
    "db:preflight-file-retention": "tsx scripts/preflight-file-retention.ts",
    "db:preflight-file-retention:ready": "tsx scripts/preflight-file-retention.ts --require-ready",
    "db:cleanup-expired-tickets": "tsx scripts/cleanup-expired-delivery-tickets.ts",
    "kb:reset:siliconflow": "tsx scripts/reset-siliconflow-knowledge-base.ts",
    "admin:init": "tsx scripts/init-admin.ts",
    "migration:manifest": "node scripts/generate-migration-manifest.mjs --output dist/migration-manifest.json",
    "release-db": "tsx scripts/release-db.ts",
    "runtime:preflight": "node scripts/validate-production-runtime.mjs",
    "verify:presales-file": "node dist/verify-presales-file-roundtrip.js"
  },
