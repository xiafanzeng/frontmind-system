{
  "schema": "frontmind-siteops-runtime/v5",
  "upstream": {
    "version": "1.0.0",
    "archiveSha256": "ca9387c9f0c7915a443e0a11449adf36f35037825d40643d12b9958d2e32856a"
  },
  "adapterVersion": "1.6.0",
  "canonicalArtifact": "build-contract.json",
  "inputSchema": "schemas/frontmind-run-envelope.schema.json",
  "visualProvider": {
    "owner": "dashboard",
    "name": "21st",
    "requiredTools": ["search"],
    "optionalTools": ["get_component"],
    "normalPathTools": ["search"],
    "primaryReferenceRole": "hero",
    "supportReferenceRoles": ["section", "motion"],
    "promptRequired": false,
    "providerCodeReuse": false
  },
  "knowledgeInput": {
    "owner": "dashboard",
    "transport": "manifest-verified-json-attachments",
    "dossierSchema": "SiteOpsSourceDossierV1",
    "inlineKnowledgeAllowed": false,
    "messageCharacterLimit": 3000,
    "singleAttachmentDecodedByteLimit": 16777216,
    "oversizePolicy": "deterministic-document-boundary-parts"
  },
  "providerWire": {
    "phaseOneSchema": "schemas/site-design-wire-v2.schema.json",
    "phaseOneCanonical": "SiteDesignSpecV1",
    "phaseOneOutputFilename": "frontmind-site-design-wire-v2.json",
    "phaseTwoSchema": "schemas/page-content-wire-v2.schema.json",
    "phaseTwoCanonical": "PageContentSpecV1",
    "phaseTwoOutputFilename": "frontmind-page-content-wire-v2.json",
    "canonicalizerOwner": "dashboard",
    "routeSlotOrder": "canonical-array-order",
    "seoOrganizationType": "Organization",
    "maximumSchemaDepth": 5
  },
  "aiTask": {
    "taskCount": 1,
    "sameTaskForBothPhases": true,
    "phaseOneOutput": "SiteDesignWireV2",
    "phaseOneOutputFilename": "frontmind-site-design-wire-v2.json",
    "phaseTwoOutput": "PageContentWireV2",
    "phaseTwoOutputFilename": "frontmind-page-content-wire-v2.json",
    "sourceOutputAllowed": false,
    "maxRepairAttempts": 3
  },
  "host": {
    "profile": "native-astro-static",
    "starterContract": "assets/host-starter-contract.json",
    "sourceOwner": "dashboard",
    "sourceDataOwner": "dashboard",
    "sourceDataFormat": "canonical-json",
    "templateOwner": "dashboard",
    "templateRuntime": "astro",
    "providerTextInterpolationIntoTemplate": false,
    "runtimeInstallAllowed": false,
    "buildOwner": "dashboard",
    "qaOwner": "dashboard"
  },
  "assetProjection": {
    "decisionIdentity": "asset-id",
    "contentIdentity": "sha256",
    "duplicateSha256Allowed": true,
    "publishAndOmitSameSha256Allowed": true,
    "publishedBrandBinding": "exact-asset-id-and-sha256",
    "quarantineConflictPolicy": "reject-emitted-sha256"
  },
  "semanticColors": {
    "owner": "dashboard",
    "roles": ["canvas", "ink", "accent", "muted"],
    "requiredContrastPairs": [
      {
        "foreground": "ink",
        "background": "canvas",
        "minimumRatio": 7
      },
      {
        "foreground": "accent",
        "background": "canvas",
        "minimumRatio": 4.5
      },
      {
        "foreground": "canvas",
        "background": "ink",
        "minimumRatio": 7
      },
      {
        "foreground": "ink",
        "background": "muted",
        "minimumRatio": 4.5
      }
    ],
    "mutedUsage": "decorative-surface-only",
    "failurePolicy": "deterministic-host-fallback",
    "providerOwnsFinalCssColors": false
  },
  "typedMaterialization": {
    "schema": "schemas/materialization-stage-v1.schema.json",
    "phases": [
      "input_validation",
      "asset_projection",
      "source_generation",
      "astro_build",
      "static_qa",
      "browser_qa",
      "lighthouse",
      "qa_packaging",
      "artifact_persistence"
    ],
    "retryClasses": ["content_repair", "host_transient", "host_deterministic"],
    "contentRepairOwner": "ai-task-output",
    "hostFailureRepairByAiAllowed": false
  }
}
