{
  "schema": "frontmind-siteops-host-starter/v3",
  "version": "2.1.0",
  "runtime": {
    "node": ">=22.19.0",
    "profile": "react-static-html",
    "react": "19",
    "renderer": "react-dom/server",
    "packageManagerAtCustomerBuildTime": false,
    "hydration": false,
    "runtimeJavaScript": false
  },
  "hostOwned": [
    "package.json",
    "package-lock.json",
    "frontmind-runtime-lock.json",
    "build-contract.json",
    "frontmind-runtime-input.json",
    "frontmind-component-manifest.json",
    "src/component-library.mjs",
    "src/render.mjs",
    "src/route-manifest.json",
    "src/data/*.json",
    "public/*"
  ],
  "output": {
    "routeDocuments": "site-brief-routes-plus-404",
    "completeHtml": true,
    "reactRootShellForbidden": true,
    "runtimeFetchForbidden": true,
    "externalScriptsForbidden": true
  },
  "visualReferencePolicy": {
    "primaryRole": "frontmind-host-candidate",
    "supportRoles": [],
    "referencesArePublishableAssets": false,
    "hostFamilyMappingRequired": true,
    "selectedFamilyIsFrozen": true
  },
  "heroFamilies": [
    "floating_orbit",
    "feature_grid",
    "bento",
    "split_media",
    "editorial",
    "centered_dual_cta",
    "immersive_visual",
    "product_stage",
    "full_bleed_statement"
  ],
  "sectionVariants": ["statement", "split", "cards", "timeline", "faq", "proof", "cta"],
  "contentBoundary": {
    "customerAndProviderText": "canonical-json-data-only",
    "reactComponents": "host-owned-only",
    "providerTextInterpolationIntoSource": false,
    "providerSourceAccepted": false
  },
  "assetDecisionPolicy": {
    "decisionIdentity": "asset-id",
    "contentIdentity": "sha256",
    "duplicateSha256Allowed": true,
    "publishAndOmitSameSha256Allowed": true,
    "publishedBrandBinding": "exact-asset-id-and-sha256",
    "quarantineConflictPolicy": "reject-emitted-sha256"
  },
  "materializationStages": {
    "schema": "schemas/materialization-stage-v2.schema.json",
    "retryOwner": "dashboard"
  }
}
