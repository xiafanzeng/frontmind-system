{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.net/schemas/siteops/materialization-stage-v3.json",
  "title": "FrontMind SiteOps Materialization Stage V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "code", "disposition", "safeDetails"],
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "wire_intake",
        "content_canonicalization",
        "palette_normalization",
        "primary_render",
        "fallback_render",
        "static_safety",
        "browser_qa",
        "artifact_persistence"
      ]
    },
    "code": { "type": "string", "pattern": "^(?:SITEOPS|BUILD)_[A-Z0-9_]+$" },
    "disposition": { "type": "string", "enum": ["blocking", "warning"] },
    "safeDetails": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  }
}
