# Copy these files to /etc/frontmind-system/ on the server, chmod 0600, and
# replace every placeholder. Never commit the resulting files.
FRONTMIND_DASHBOARD_IMAGE=ghcr.io/xiafanzeng/frontmind-system-dashboard@sha256:replace-me
FRONTMIND_MONITORING_WORKER_IMAGE=ghcr.io/xiafanzeng/frontmind-system-worker@sha256:replace-me
FRONTMIND_DASHBOARD_DIGEST=sha256:replace-me
FRONTMIND_MONITORING_WORKER_DIGEST=sha256:replace-me
FRONTMIND_SYSTEM_ENV_DIR=/etc/frontmind-system
FRONTMIND_MYSQL_DIR=/srv/frontmind-system/mysql
FRONTMIND_BACKUP_DIR=/srv/frontmind-system/backups
FRONTMIND_PREPARED_FILE_DIR_HOST=/srv/frontmind-system/runtime/prepared-files
FRONTMIND_DASHBOARD_ASSET_DIR_HOST=/srv/frontmind-system/runtime/dashboard-assets
FRONTMIND_DASHBOARD_HOST_PORT=3001

# IPv4 phase: domain and HTTPS are intentionally deferred.
FRONTMIND_PUBLIC_URL=http://149.88.85.240
PUBLIC_ORIGIN=http://149.88.85.240
FRONTMIND_WEBSITE_URL=https://www.frontmind.cn
COOKIE_SECURE=false
TRUST_PROXY=true

# Use long, independently generated values in the server env files.
MYSQL_ROOT_PASSWORD=replace-with-random-secret
MYSQL_PASSWORD=replace-with-random-secret
FRONTMIND_CREDENTIAL_ENCRYPTION_KEY=base64:replace-with-32-random-bytes
FRONTMIND_PRESALES_SERVICE_TOKEN=replace-with-independent-random-secret
FRONTMIND_PROVISIONING_SERVICE_TOKEN=replace-with-independent-random-secret
FRONTMIND_DASHBOARD_IMPORT_PREFLIGHT_SECRET=replace-with-independent-random-secret
FRONTMIND_MONITOR_API_KEY=replace-with-dedicated-monitor-key
