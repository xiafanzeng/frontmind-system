{
  "name": "@frontmind/monitoring-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/router.ts",
      "import": "./dist/router.js",
      "default": "./dist/router.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@frontmind/monitoring-config": "workspace:*",
    "@frontmind/monitoring-contracts": "workspace:*",
    "@frontmind/monitoring-db": "workspace:*",
    "@frontmind/monitoring-object-store": "workspace:*",
    "@frontmind/monitoring-payment": "workspace:*",
    "@frontmind/monitoring-publisher": "workspace:*",
    "@trpc/server": "^11.7.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
