{
  "name": "@frontmind/monitoring-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./canonical-html": {
      "types": "./src/canonical-html.ts",
      "import": "./dist/canonical-html.js",
      "default": "./dist/canonical-html.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "icojs": "1.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.10.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1"
  }
}
